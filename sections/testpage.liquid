{{ 'testpage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testpage.js' | asset_url }}" defer></script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Jost:wght@300;400;500;600&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<div
  id="shopify-section-{{ section.id }}"
  class="sd-testpage shopify-section"
  style="--sd-spacing-top: {{ section.settings.padding_top }}px; --sd-spacing-bottom: {{ section.settings.padding_bottom }}px;"
>
  <sd-testpage>

    <!-- ============================================================
         ANNOUNCEMENT BAR
    ============================================================ -->
    {%- if section.settings.announcement_text != blank -%}
      <div class="sd-testpage__announcement-bar">
        <p class="sd-testpage__announcement-text">{{ section.settings.announcement_text }}</p>
      </div>
    {%- endif -%}

    <!-- ============================================================
         HEADER / NAVIGATION
    ============================================================ -->
    <header class="sd-testpage__header" role="banner">
      <div class="sd-testpage__header-inner">
        <nav class="sd-testpage__nav sd-testpage__nav--top" aria-label="Primary navigation">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'nav_link' -%}
                <a href="{{ block.settings.link_url }}" class="sd-testpage__nav-link" {{ block.shopify_attributes }}>{{ block.settings.link_label }}</a>
            {%- endcase -%}
          {%- endfor -%}
        </nav>
        <div class="sd-testpage__logo-wrap">
          {%- if section.settings.logo_image != blank -%}
            {{
              section.settings.logo_image
              | image_url: width: 300
              | image_tag:
                class: 'sd-testpage__logo',
                alt: section.settings.logo_image.alt | default: shop.name,
                width: 150,
                height: 40,
                loading: 'eager'
            }}
          {%- else -%}
            <span class="sd-testpage__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </div>
        <nav class="sd-testpage__nav sd-testpage__nav--bottom" aria-label="Secondary navigation">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'nav_link_secondary' -%}
                <a href="{{ block.settings.link_url }}" class="sd-testpage__nav-link sd-testpage__nav-link--secondary" {{ block.shopify_attributes }}>{{ block.settings.link_label }}</a>
            {%- endcase -%}
          {%- endfor -%}
        </nav>
      </div>
    </header>

    <!-- ============================================================
         HERO SECTION
    ============================================================ -->
    <section class="sd-testpage__hero" aria-label="Hero section">
      <div class="sd-testpage__hero-inner">
        <div class="sd-testpage__hero-image-col">
          {%- if section.settings.hero_image != blank -%}
            {{
              section.settings.hero_image
              | image_url: width: 900
              | image_tag:
                class: 'sd-testpage__hero-image',
                alt: section.settings.hero_image.alt | default: section.settings.hero_heading,
                width: 600,
                height: 700,
                loading: 'eager',
                fetchpriority: 'high'
            }}
          {%- else -%}
            <div class="sd-testpage__hero-image-placeholder"><!-- PLACEHOLDER: Upload hero product image --></div>
          {%- endif -%}
        </div>
        <div class="sd-testpage__hero-content-col">
          {%- unless section.settings.hero_heading == blank -%}
            <h1 class="sd-testpage__hero-heading">{{ section.settings.hero_heading }}</h1>
          {%- endunless -%}
          {%- unless section.settings.hero_body == blank -%}
            <div class="sd-testpage__hero-body">{{ section.settings.hero_body }}</div>
          {%- endunless -%}
          {%- if section.settings.hero_cta_label != blank and section.settings.hero_cta_url != blank -%}
            <a href="{{ section.settings.hero_cta_url }}" class="sd-testpage__btn sd-testpage__btn--primary">
              {{ section.settings.hero_cta_label }}
            </a>
          {%- endif -%}
          <div class="sd-testpage__hero-rating" aria-label="Customer rating">
            <span class="sd-testpage__stars" aria-hidden="true">
              <svg width="100" height="18" viewBox="0 0 100 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="9,1 11,6 16,6 12,10 13.5,15 9,12 4.5,15 6,10 2,6 7,6" fill="#C4956A"/>
                <polygon points="29,1 31,6 36,6 32,10 33.5,15 29,12 24.5,15 26,10 22,6 27,6" fill="#C4956A"/>
                <polygon points="49,1 51,6 56,6 52,10 53.5,15 49,12 44.5,15 46,10 42,6 47,6" fill="#C4956A"/>
                <polygon points="69,1 71,6 76,6 72,10 73.5,15 69,12 64.5,15 66,10 62,6 67,6" fill="#C4956A"/>
                <polygon points="89,1 91,6 96,6 92,10 93.5,15 89,12 84.5,15 86,10 82,6 87,6" fill="#C4956A"/>
              </svg>
            </span>
            {%- unless section.settings.hero_rating_text == blank -%}
              <span class="sd-testpage__rating-text">{{ section.settings.hero_rating_text }}</span>
            {%- endunless -%}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         PRESS QUOTE BAR
    ============================================================ -->
    <section class="sd-testpage__press-bar" aria-label="Press mentions">
      <div class="sd-testpage__press-bar-inner">
        {%- unless section.settings.press_quote == blank -%}
          <blockquote class="sd-testpage__press-quote">
            <p>"{{ section.settings.press_quote }}"</p>
          </blockquote>
        {%- endunless -%}
        <div class="sd-testpage__press-logos" aria-label="Press outlet logos">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'press_logo' -%}
                <div class="sd-testpage__press-logo-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.logo_image != blank -%}
                    {{
                      block.settings.logo_image
                      | image_url: width: 200
                      | image_tag:
                        class: 'sd-testpage__press-logo-img',
                        alt: block.settings.logo_alt | default: 'Press logo',
                        width: 120,
                        height: 40,
                        loading: 'lazy'
                    }}
                  {%- elsif block.settings.logo_text != blank -%}
                    <span class="sd-testpage__press-logo-text">{{ block.settings.logo_text }}</span>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    <!-- ============================================================
         INTRO / VALUE PROPOSITION SECTION
    ============================================================ -->
    <section class="sd-testpage__intro" aria-label="Value proposition">
      <div class="sd-testpage__intro-inner">
        {%- unless section.settings.intro_heading == blank -%}
          <h2 class="sd-testpage__intro-heading" data-animate>{{ section.settings.intro_heading }}</h2>
        {%- endunless -%}
        {%- unless section.settings.intro_body == blank -%}
          <div class="sd-testpage__intro-body" data-animate>{{ section.settings.intro_body }}</div>
        {%- endunless -%}
      </div>
    </section>

    <!-- ============================================================
         HOW IT WORKS SECTION
    ============================================================ -->
    <section class="sd-testpage__how" aria-label="How it works">
      <div class="sd-testpage__how-inner">
        {%- unless section.settings.how_heading == blank -%}
          <h2 class="sd-testpage__how-heading" data-animate>{{ section.settings.how_heading }}</h2>
        {%- endunless -%}

        <!-- Desktop Grid (hidden on mobile) -->
        <div class="sd-testpage__how-grid">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'how_step' -%}
                <div class="sd-testpage__how-step" {{ block.shopify_attributes }} data-animate>
                  <div class="sd-testpage__how-step-image-wrap">
                    {%- if block.settings.step_image != blank -%}
                      {{
                        block.settings.step_image
                        | image_url: width: 400
                        | image_tag:
                          class: 'sd-testpage__how-step-image',
                          alt: block.settings.step_image.alt | default: block.settings.step_title,
                          width: 280,
                          height: 280,
                          loading: 'lazy'
                      }}
                    {%- endif -%}
                  </div>
                  {%- unless block.settings.step_title == blank -%}
                    <h3 class="sd-testpage__how-step-title">{{ block.settings.step_title }}</h3>
                  {%- endunless -%}
                  {%- unless block.settings.step_body == blank -%}
                    <p class="sd-testpage__how-step-body">{{ block.settings.step_body }}</p>
                  {%- endunless -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <!-- Mobile Swiper (hidden on desktop) -->
        <div class="sd-testpage__how-swiper swiper">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'how_step' -%}
                  <div class="swiper-slide sd-testpage__how-step" {{ block.shopify_attributes }}>
                    <div class="sd-testpage__how-step-image-wrap">
                      {%- if block.settings.step_image != blank -%}
                        {{
                          block.settings.step_image
                          | image_url: width: 400
                          | image_tag:
                            class: 'sd-testpage__how-step-image',
                            alt: block.settings.step_image.alt | default: block.settings.step_title,
                            width: 280,
                            height: 280,
                            loading: 'lazy'
                        }}
                      {%- endif -%}
                    </div>
                    {%- unless block.settings.step_title == blank -%}
                      <h3 class="sd-testpage__how-step-title">{{ block.settings.step_title }}</h3>
                    {%- endunless -%}
                    {%- unless block.settings.step_body == blank -%}
                      <p class="sd-testpage__how-step-body">{{ block.settings.step_body }}</p>
                    {%- endunless -%}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
          <div class="swiper-pagination sd-testpage__how-pagination"></div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SPLIT CONTENT BLOCKS
         (ON, Polished Not Painted, Clean Ingredients, 15 Shades, Built For Briefcase)
    ============================================================ -->
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'split_content' -%}
          <section
            class="sd-testpage__split{% if block.settings.reverse_layout %}  sd-testpage__split--reversed{% endif %}"
            aria-label="{{ block.settings.split_heading }}"
            {{ block.shopify_attributes }}
          >
            <div class="sd-testpage__split-inner">
              <div class="sd-testpage__split-image-col">
                {%- if block.settings.split_image != blank -%}
                  {{
                    block.settings.split_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'sd-testpage__split-image',
                      alt: block.settings.split_image.alt | default: block.settings.split_heading,
                      width: 600,
                      height: 720,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  <div class="sd-testpage__split-image-placeholder"><!-- PLACEHOLDER: Upload split content image --></div>
                {%- endif -%}
              </div>
              <div class="sd-testpage__split-content-col">
                {%- unless block.settings.split_eyebrow == blank -%}
                  <span class="sd-testpage__split-eyebrow">{{ block.settings.split_eyebrow }}</span>
                {%- endunless -%}
                {%- unless block.settings.split_heading == blank -%}
                  <h2 class="sd-testpage__split-heading">{{ block.settings.split_heading }}</h2>
                {%- endunless -%}
                {%- unless block.settings.split_body == blank -%}
                  <div class="sd-testpage__split-body">{{ block.settings.split_body }}</div>
                {%- endunless -%}
                {%- if block.settings.split_cta_label != blank and block.settings.split_cta_url != blank -%}
                  <a href="{{ block.settings.split_cta_url }}" class="sd-testpage__btn sd-testpage__btn--primary">
                    {{ block.settings.split_cta_label }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </section>
      {%- endcase -%}
    {%- endfor -%}

    <!-- ============================================================
         DARK QUOTE BANNER
    ============================================================ -->
    <section class="sd-testpage__dark-quote" aria-label="Featured quote">
      <div class="sd-testpage__dark-quote-inner">
        {%- unless section.settings.dark_quote_text == blank -%}
          <blockquote class="sd-testpage__dark-quote-text">
            <p>"{{ section.settings.dark_quote_text }}"</p>
          </blockquote>
        {%- endunless -%}
        {%- if section.settings.dark_quote_cta_label != blank and section.settings.dark_quote_cta_url != blank -%}
          <a href="{{ section.settings.dark_quote_cta_url }}" class="sd-testpage__btn sd-testpage__btn--outline-light">
            {{ section.settings.dark_quote_cta_label }}
          </a>
        {%- endif -%}
      </div>
    </section>

    <!-- ============================================================
         STATS BAR
    ============================================================ -->
    <section class="sd-testpage__stats" aria-label="Brand statistics">
      <div class="sd-testpage__stats-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'stat_item' -%}
              <div class="sd-testpage__stat-item" {{ block.shopify_attributes }} data-animate>
                <span class="sd-testpage__stat-number">{{ block.settings.stat_number }}</span>
                <span class="sd-testpage__stat-label">{{ block.settings.stat_label }}</span>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </section>

    <!-- ============================================================
         TESTIMONIALS / REVIEWS SECTION
    ============================================================ -->
    <section class="sd-testpage__reviews" aria-label="Customer reviews">
      <div class="sd-testpage__reviews-inner">
        {%- unless section.settings.reviews_heading == blank -%}
          <h2 class="sd-testpage__reviews-heading" data-animate>{{ section.settings.reviews_heading }}</h2>
        {%- endunless -%}

        <!-- Desktop Grid (hidden on mobile) -->
        <div class="sd-testpage__reviews-grid">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'review_card' -%}
                <article class="sd-testpage__review-card" {{ block.shopify_attributes }} data-animate>
                  {%- assign star_count = block.settings.review_rating | default: 5 -%}
                  <div class="sd-testpage__review-stars" aria-label="{{ star_count }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      <span class="sd-testpage__review-star{% if i > star_count %}  sd-testpage__review-star--empty{% endif %}" aria-hidden="true">&#9733;</span>
                    {%- endfor -%}
                  </div>
                  {%- unless block.settings.review_title == blank -%}
                    <h4 class="sd-testpage__review-title">{{ block.settings.review_title }}</h4>
                  {%- endunless -%}
                  {%- unless block.settings.review_body == blank -%}
                    <p class="sd-testpage__review-body">{{ block.settings.review_body }}</p>
                  {%- endunless -%}
                  {%- unless block.settings.review_author == blank -%}
                    <cite class="sd-testpage__review-author">— {{ block.settings.review_author }}</cite>
                  {%- endunless -%}
                </article>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <!-- Mobile Swiper (hidden on desktop) -->
        <div class="sd-testpage__reviews-swiper swiper" id="reviews-swiper-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'review_card' -%}
                  <article class="swiper-slide sd-testpage__review-card" {{ block.shopify_attributes }}>
                    {%- assign star_count_m = block.settings.review_rating | default: 5 -%}
                    <div class="sd-testpage__review-stars" aria-label="{{ star_count_m }} out of 5 stars">
                      {%- for i in (1..5) -%}
                        <span class="sd-testpage__review-star{% if i > star_count_m %}  sd-testpage__review-star--empty{% endif %}" aria-hidden="true">&#9733;</span>
                      {%- endfor -%}
                    </div>
                    {%- unless block.settings.review_title == blank -%}
                      <h4 class="sd-testpage__review-title">{{ block.settings.review_title }}</h4>
                    {%- endunless -%}
                    {%- unless block.settings.review_body == blank -%}
                      <p class="sd-testpage__review-body">{{ block.settings.review_body }}</p>
                    {%- endunless -%}
                    {%- unless block.settings.review_author == blank -%}
                      <cite class="sd-testpage__review-author">— {{ block.settings.review_author }}</cite>
                    {%- endunless -%}
                  </article>
              {%- endcase -%}
            {%- endfor -%}
          </div>
          <button type="button" class="sd-testpage__reviews-prev swiper-button-prev" aria-label="Previous review"></button>
          <button type="button" class="sd-testpage__reviews-next swiper-button-next" aria-label="Next review"></button>
        </div>
      </div>
    </section>

    <!-- ============================================================
         THIS ISN'T ANOTHER BEAUTY PRODUCT — FEATURE LIST
    ============================================================ -->
    <section class="sd-testpage__features" aria-label="Product features">
      <div class="sd-testpage__features-inner">
        {%- unless section.settings.features_heading == blank -%}
          <h2 class="sd-testpage__features-heading" data-animate>{{ section.settings.features_heading }}</h2>
        {%- endunless -%}
        {%- unless section.settings.features_subheading == blank -%}
          <div class="sd-testpage__features-subheading" data-animate>{{ section.settings.features_subheading }}</div>
        {%- endunless -%}
        <div class="sd-testpage__features-grid">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'feature_item' -%}
                <div class="sd-testpage__feature-item" {{ block.shopify_attributes }} data-animate>
                  {%- if block.settings.feature_icon != blank -%}
                    {{
                      block.settings.feature_icon
                      | image_url: width: 80
                      | image_tag:
                        class: 'sd-testpage__feature-icon',
                        alt: '',
                        width: 48,
                        height: 48,
                        loading: 'lazy'
                    }}
                  {%- endif -%}
                  {%- unless block.settings.feature_title == blank -%}
                    <h3 class="sd-testpage__feature-title">{{ block.settings.feature_title }}</h3>
                  {%- endunless -%}
                  {%- unless block.settings.feature_body == blank -%}
                    <div class="sd-testpage__feature-body">{{ block.settings.feature_body }}</div>
                  {%- endunless -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    <!-- ============================================================
         PRODUCT DETAIL / MINI MIRACLE BALM SECTION
    ============================================================ -->
    <section class="sd-testpage__product-highlight" aria-label="Product detail">
      <div class="sd-testpage__product-highlight-inner">
        <div class="sd-testpage__product-image-col">
          {%- if section.settings.product_image != blank -%}
            {{
              section.settings.product_image
              | image_url: width: 800
              | image_tag:
                class: 'sd-testpage__product-image',
                alt: section.settings.product_image.alt | default: section.settings.product_name,
                width: 560,
                height: 560,
                loading: 'lazy'
            }}
          {%- else -%}
            <div class="sd-testpage__product-image-placeholder"><!-- PLACEHOLDER: Upload product highlight image --></div>
          {%- endif -%}
        </div>

        <div class="sd-testpage__product-content-col">
          {%- unless section.settings.product_name == blank -%}
            <h2 class="sd-testpage__product-name">{{ section.settings.product_name }}</h2>
          {%- endunless -%}
          {%- unless section.settings.product_description == blank -%}
            <div class="sd-testpage__product-description">{{ section.settings.product_description }}</div>
          {%- endunless -%}

          {%- assign product_handle = section.settings.product_handle -%}
          {%- if product_handle != blank -%}
            {%- assign featured_product = all_products[product_handle] -%}
          {%- endif -%}

          {%- if featured_product != blank -%}
            <!-- Shade Swatches from live product variants -->
            <!-- METAFIELD: custom.swatch_color — create this on Product Variant in Shopify admin -->
            <div class="sd-testpage__shade-swatches" role="group" aria-label="Select a shade">
              {%- for variant in featured_product.variants -%}
                <button
                  type="button"
                  class="sd-testpage__swatch{% if forloop.first %}  sd-testpage__swatch--active{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  style="background-color: {{ variant.metafields.custom.swatch_color | default: '#ccb8a8' }};"
                  aria-label="{{ variant.title }}"
                  aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                  {% unless variant.available %}disabled{% endunless %}
                ></button>
              {%- endfor -%}
            </div>

            <form
              action="{{ routes.cart_add_url }}"
              method="post"
              enctype="multipart/form-data"
              class="sd-testpage__atc-form"
              id="atc-form-{{ section.id }}"
            >
              <input type="hidden" name="form_type" value="product">
              <input type="hidden" name="utf8" value="✓">
              <input
                type="hidden"
                name="id"
                value="{{ featured_product.selected_or_first_available_variant.id }}"
                data-sd-variant-input
              >
              <div class="sd-testpage__product-price">
                {{ featured_product.selected_or_first_available_variant.price | money }}
              </div>
              <button
                type="submit"
                name="add"
                class="sd-testpage__btn sd-testpage__btn--primary sd-testpage__btn--atc"
                aria-label="{{ 'products.product.add_to_cart' | t }}"
                {% unless featured_product.selected_or_first_available_variant.available %}disabled{% endunless %}
              >
                {{ 'products.product.add_to_cart' | t }}
              </button>
            </form>

          {%- else -%}
            {%- comment -%} Fallback when no product handle is set {%- endcomment -%}
            {%- unless section.settings.product_price == blank -%}
              <div class="sd-testpage__product-price">{{ section.settings.product_price }}</div>
            {%- endunless -%}
            {%- if section.settings.product_cta_label != blank and section.settings.product_cta_url != blank -%}
              <a
                href="{{ section.settings.product_cta_url }}"
                class="sd-testpage__btn sd-testpage__btn--primary sd-testpage__btn--atc"
              >
                {{ section.settings.product_cta_label }}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </section>

    <!-- ============================================================
         FAQ / ACCORDION SECTION
    ============================================================ -->
    <section class="sd-testpage__faq" aria-label="Frequently asked questions">
      <div class="sd-testpage__faq-inner">
        {%- unless section.settings.faq_heading == blank -%}
          <h2 class="sd-testpage__faq-heading" data-animate>{{ section.settings.faq_heading }}</h2>
        {%- endunless -%}
        <div class="sd-testpage__faq-list">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'faq_item' -%}
                <details class="sd-testpage__faq-item" {{ block.shopify_attributes }}>
                  <summary class="sd-testpage__faq-question">
                    <span class="sd-testpage__faq-question-text">{{ block.settings.faq_question }}</span>
                    <span class="sd-testpage__faq-icon" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 5L8 11L14 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </summary>
                  <div class="sd-testpage__faq-answer">
                    {{ block.settings.faq_answer }}
                  </div>
                </details>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </section>

    <!-- ============================================================
         FOOTER CTA BANNER
    ============================================================ -->
    <section class="sd-testpage__footer-cta" aria-label="Call to action">
      <div class="sd-testpage__footer-cta-inner">
        {%- unless section.settings.footer_cta_heading == blank -%}
          <h2 class="sd-testpage__footer-cta-heading">{{ section.settings.footer_cta_heading }}</h2>
        {%- endunless -%}
        {%- if section.settings.footer_cta_label != blank and section.settings.footer_cta_url != blank -%}
          <a href="{{ section.settings.footer_cta_url }}" class="sd-testpage__btn sd-testpage__btn--primary">
            {{ section.settings.footer_cta_label }}
          </a>
        {%- endif -%}
      </div>
    </section>

  </sd-testpage>
</div>

