{{ 'sd-frame-8234.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sd-frame-8234.js' | asset_url }}" defer></script>

<!-- Bundle Builder Section: sd-frame-8234 -->
<div
  id="shopify-section-{{ section.id }}"
  class="sd-frame-8234 shopify-section"
  style="--sd-spacing-top: {{ section.settings.padding_top }}px; --sd-spacing-bottom: {{ section.settings.padding_bottom }}px;"
>
  <sd-frame-8234 data-section-id="{{ section.id }}">

    <!-- Step Progress Indicator -->
    <div class="sd-frame-8234__progress-bar" aria-label="Bundle builder progress">
      <span class="sd-frame-8234__progress-label" data-progress-label>{{ section.settings.progress_label }}</span>
    </div>

    <!-- STEP 1: Choose your cameras -->
    <div
      class="sd-frame-8234__step sd-frame-8234__step--active"
      data-step="1"
      data-step-key="cameras"
      id="sd-step-cameras-{{ section.id }}"
    >
      <div
        class="sd-frame-8234__step-header"
        role="button"
        tabindex="0"
        aria-expanded="true"
        aria-controls="sd-step-cameras-body-{{ section.id }}"
      >
        <div class="sd-frame-8234__step-header-left">
          <span class="sd-frame-8234__step-icon sd-frame-8234__step-icon--svg" aria-hidden="true">
            {%- if section.settings.step1_icon != blank -%}
              {{ section.settings.step1_icon | image_url: width: 28 | image_tag: loading: 'lazy', widths: '28,56', alt: '' }}
            {%- else -%}
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="1" y="4" width="15" height="11" rx="2" stroke="#5B5FCF" stroke-width="1.5"/><path d="M16 8.5L21 6v10l-5-2.5V8.5Z" stroke="#5B5FCF" stroke-width="1.5" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </span>
          <h2 class="sd-frame-8234__step-title">{{ section.settings.step1_title }}</h2>
        </div>
        <div class="sd-frame-8234__step-header-right">
          <span class="sd-frame-8234__step-selected-badge" data-selected-badge="cameras" aria-live="polite">
            <span data-selected-count="cameras">0</span>&nbsp;{{ section.settings.selected_label }}
            <svg class="sd-frame-8234__badge-arrow" width="10" height="7" viewBox="0 0 10 7" fill="none" aria-hidden="true"><path d="M9 6L5 2L1 6" stroke="#5B5FCF" stroke-width="1.5" stroke-linecap="round"/></svg>
          </span>
          <svg class="sd-frame-8234__step-chevron" width="14" height="9" viewBox="0 0 14 9" fill="none" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="#5B5FCF" stroke-width="1.8" stroke-linecap="round"/></svg>
        </div>
      </div>

      <div
        class="sd-frame-8234__step-body"
        id="sd-step-cameras-body-{{ section.id }}"
        data-step-body="cameras"
      >
        <div class="sd-frame-8234__product-grid" data-product-grid="cameras">
          {%- assign camera_blocks = section.blocks | where: 'type', 'camera_product' -%}
          {%- assign camera_count = camera_blocks | size -%}
          {%- assign camera_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'camera_product' -%}
              {%- assign camera_index = camera_index | plus: 1 -%}
              {%- assign camera_mod = camera_count | modulo: 2 -%}
              {%- assign is_last_odd = false -%}
              {%- if camera_mod == 1 and camera_index == camera_count -%}
                {%- assign is_last_odd = true -%}
              {%- endif -%}
              {%- assign block_product = all_products[block.settings.product] -%}
              {%- assign selected_variant = block_product.selected_or_first_available_variant -%}
              <div
                class="sd-frame-8234__product-card-wrap{% if is_last_odd %} sd-frame-8234__product-card-wrap--centered{% endif %}"
                {{ block.shopify_attributes }}
                data-product-handle="{{ block_product.handle }}"
                data-product-id="{{ block_product.id }}"
              >
                {% render 'bundle-product-card',
                  block: block,
                  product: block_product,
                  selected_variant: selected_variant,
                  step_key: 'cameras',
                  section_id: section.id
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Step 1 Next CTA -->
        <div class="sd-frame-8234__step-cta">
          <button
            type="button"
            class="sd-frame-8234__next-btn"
            data-next-step="2"
            aria-label="{{ section.settings.step1_cta_label }}"
          >
            {{ section.settings.step1_cta_label }}
          </button>
        </div>
      </div>
    </div>

    <!-- STEP 2: Choose your plan -->
    <div
      class="sd-frame-8234__step sd-frame-8234__step--collapsed"
      data-step="2"
      data-step-key="plan"
      id="sd-step-plan-{{ section.id }}"
    >
      <div
        class="sd-frame-8234__step-header"
        role="button"
        tabindex="0"
        aria-expanded="false"
        aria-controls="sd-step-plan-body-{{ section.id }}"
      >
        <div class="sd-frame-8234__step-header-left">
          <span class="sd-frame-8234__step-icon sd-frame-8234__step-icon--svg" aria-hidden="true">
            {%- if section.settings.step2_icon != blank -%}
              {{ section.settings.step2_icon | image_url: width: 28 | image_tag: loading: 'lazy', widths: '28,56', alt: '' }}
            {%- else -%}
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11 2L3 5.5V11c0 4.5 3.5 8 8 9.5C19 19 22 15.5 22 11V5.5L11 2Z" stroke="#5B5FCF" stroke-width="1.5" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </span>
          <h2 class="sd-frame-8234__step-title">{{ section.settings.step2_title }}</h2>
        </div>
        <div class="sd-frame-8234__step-header-right">
          <svg class="sd-frame-8234__step-chevron sd-frame-8234__step-chevron--down" width="14" height="9" viewBox="0 0 14 9" fill="none" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="#5B5FCF" stroke-width="1.8" stroke-linecap="round"/></svg>
        </div>
      </div>
      <div
        class="sd-frame-8234__step-body"
        id="sd-step-plan-body-{{ section.id }}"
        data-step-body="plan"
        hidden
      >
        <div class="sd-frame-8234__product-grid" data-product-grid="plan">
          {%- for block in section.blocks -%}
            {%- if block.type == 'plan_product' -%}
              {%- assign block_product = all_products[block.settings.product] -%}
              {%- assign selected_variant = block_product.selected_or_first_available_variant -%}
              <div
                class="sd-frame-8234__product-card-wrap"
                {{ block.shopify_attributes }}
                data-product-handle="{{ block_product.handle }}"
                data-product-id="{{ block_product.id }}"
              >
                {% render 'bundle-product-card',
                  block: block,
                  product: block_product,
                  selected_variant: selected_variant,
                  step_key: 'plan',
                  section_id: section.id
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="sd-frame-8234__step-cta">
          <button
            type="button"
            class="sd-frame-8234__next-btn"
            data-next-step="3"
            aria-label="{{ section.settings.step2_cta_label }}"
          >
            {{ section.settings.step2_cta_label }}
          </button>
        </div>
      </div>
    </div>

    <!-- STEP 3: Choose your sensors -->
    <div
      class="sd-frame-8234__step sd-frame-8234__step--collapsed"
      data-step="3"
      data-step-key="sensors"
      id="sd-step-sensors-{{ section.id }}"
    >
      <div
        class="sd-frame-8234__step-header"
        role="button"
        tabindex="0"
        aria-expanded="false"
        aria-controls="sd-step-sensors-body-{{ section.id }}"
      >
        <div class="sd-frame-8234__step-header-left">
          <span class="sd-frame-8234__step-icon sd-frame-8234__step-icon--svg" aria-hidden="true">
            {%- if section.settings.step3_icon != blank -%}
              {{ section.settings.step3_icon | image_url: width: 28 | image_tag: loading: 'lazy', widths: '28,56', alt: '' }}
            {%- else -%}
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="9" stroke="#5B5FCF" stroke-width="1.5"/><circle cx="11" cy="11" r="4" stroke="#5B5FCF" stroke-width="1.5"/><circle cx="11" cy="11" r="1.5" fill="#5B5FCF"/></svg>
            {%- endif -%}
          </span>
          <h2 class="sd-frame-8234__step-title">{{ section.settings.step3_title }}</h2>
        </div>
        <div class="sd-frame-8234__step-header-right">
          <svg class="sd-frame-8234__step-chevron sd-frame-8234__step-chevron--down" width="14" height="9" viewBox="0 0 14 9" fill="none" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="#5B5FCF" stroke-width="1.8" stroke-linecap="round"/></svg>
        </div>
      </div>
      <div
        class="sd-frame-8234__step-body"
        id="sd-step-sensors-body-{{ section.id }}"
        data-step-body="sensors"
        hidden
      >
        <div class="sd-frame-8234__product-grid" data-product-grid="sensors">
          {%- for block in section.blocks -%}
            {%- if block.type == 'sensor_product' -%}
              {%- assign block_product = all_products[block.settings.product] -%}
              {%- assign selected_variant = block_product.selected_or_first_available_variant -%}
              <div
                class="sd-frame-8234__product-card-wrap"
                {{ block.shopify_attributes }}
                data-product-handle="{{ block_product.handle }}"
                data-product-id="{{ block_product.id }}"
              >
                {% render 'bundle-product-card',
                  block: block,
                  product: block_product,
                  selected_variant: selected_variant,
                  step_key: 'sensors',
                  section_id: section.id
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="sd-frame-8234__step-cta">
          <button
            type="button"
            class="sd-frame-8234__next-btn"
            data-next-step="4"
            aria-label="{{ section.settings.step3_cta_label }}"
          >
            {{ section.settings.step3_cta_label }}
          </button>
        </div>
      </div>
    </div>

    <!-- STEP 4: Add extra protection -->
    <div
      class="sd-frame-8234__step sd-frame-8234__step--collapsed sd-frame-8234__step--last"
      data-step="4"
      data-step-key="protection"
      id="sd-step-protection-{{ section.id }}"
    >
      <div
        class="sd-frame-8234__step-header"
        role="button"
        tabindex="0"
        aria-expanded="false"
        aria-controls="sd-step-protection-body-{{ section.id }}"
      >
        <div class="sd-frame-8234__step-header-left">
          <span class="sd-frame-8234__step-icon sd-frame-8234__step-icon--svg" aria-hidden="true">
            {%- if section.settings.step4_icon != blank -%}
              {{ section.settings.step4_icon | image_url: width: 28 | image_tag: loading: 'lazy', widths: '28,56', alt: '' }}
            {%- else -%}
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="8" height="8" rx="1.5" stroke="#5B5FCF" stroke-width="1.5"/><rect x="12" y="2" width="8" height="8" rx="1.5" stroke="#5B5FCF" stroke-width="1.5"/><rect x="2" y="12" width="8" height="8" rx="1.5" stroke="#5B5FCF" stroke-width="1.5"/><rect x="12" y="12" width="8" height="8" rx="1.5" stroke="#5B5FCF" stroke-width="1.5"/></svg>
            {%- endif -%}
          </span>
          <h2 class="sd-frame-8234__step-title">{{ section.settings.step4_title }}</h2>
        </div>
        <div class="sd-frame-8234__step-header-right">
          <svg class="sd-frame-8234__step-chevron sd-frame-8234__step-chevron--down" width="14" height="9" viewBox="0 0 14 9" fill="none" aria-hidden="true"><path d="M1 1L7 7L13 1" stroke="#5B5FCF" stroke-width="1.8" stroke-linecap="round"/></svg>
        </div>
      </div>
      <div
        class="sd-frame-8234__step-body"
        id="sd-step-protection-body-{{ section.id }}"
        data-step-body="protection"
        hidden
      >
        <div class="sd-frame-8234__product-grid" data-product-grid="protection">
          {%- for block in section.blocks -%}
            {%- if block.type == 'protection_product' -%}
              {%- assign block_product = all_products[block.settings.product] -%}
              {%- assign selected_variant = block_product.selected_or_first_available_variant -%}
              <div
                class="sd-frame-8234__product-card-wrap"
                {{ block.shopify_attributes }}
                data-product-handle="{{ block_product.handle }}"
                data-product-id="{{ block_product.id }}"
              >
                {% render 'bundle-product-card',
                  block: block,
                  product: block_product,
                  selected_variant: selected_variant,
                  step_key: 'protection',
                  section_id: section.id
                %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Final Add to Cart -->
        <div class="sd-frame-8234__step-cta sd-frame-8234__step-cta--final">
          <div class="sd-frame-8234__bundle-total" aria-live="polite">
            <span class="sd-frame-8234__bundle-total-label">{{ section.settings.total_label }}</span>
            <span class="sd-frame-8234__bundle-total-price" data-bundle-total>$0.00</span>
          </div>
          <button
            type="button"
            class="sd-frame-8234__next-btn sd-frame-8234__next-btn--atc"
            data-atc-bundle
            aria-label="{{ section.settings.atc_label }}"
          >
            {{ section.settings.atc_label }}
          </button>
          {%- unless section.settings.atc_note == blank -%}
            <p class="sd-frame-8234__atc-note">{{ section.settings.atc_note }}</p>
          {%- endunless -%}
        </div>
      </div>
    </div>

  </sd-frame-8234>
</div>

{% schema %}
{
  "name": "Bundle Builder",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Bundle Builder"
    },
    {
      "type": "text",
      "id": "progress_label",
      "label": "Progress label",
      "default": "Build your bundle — Step 1 of 4"
    },
    {
      "type": "header",
      "content": "Step 1 — Cameras"
    },
    {
      "type": "image_picker",
      "id": "step1_icon",
      "label": "Step 1 icon (optional)"
    },
    {
      "type": "text",
      "id": "step1_title",
      "label": "Step 1 title",
      "default": "Choose your cameras"
    },
    {
      "type": "text",
      "id": "selected_label",
      "label": "Selected count label",
      "default": "selected"
    },
    {
      "type": "text",
      "id": "step1_cta_label",
      "label": "Step 1 CTA label",
      "default": "Next: Choose your plan"
    },
    {
      "type": "header",
      "content": "Step 2 — Plan"
    },
    {
      "type": "image_picker",
      "id": "step2_icon",
      "label": "Step 2 icon (optional)"
    },
    {
      "type": "text",
      "id": "step2_title",
      "label": "Step 2 title",
      "default": "Choose your plan"
    },
    {
      "type": "text",
      "id": "step2_cta_label",
      "label": "Step 2 CTA label",
      "default": "Next: Choose your sensors"
    },
    {
      "type": "header",
      "content": "Step 3 — Sensors"
    },
    {
      "type": "image_picker",
      "id": "step3_icon",
      "label": "Step 3 icon (optional)"
    },
    {
      "type": "text",
      "id": "step3_title",
      "label": "Step 3 title",
      "default": "Choose your sensors"
    },
    {
      "type": "text",
      "id": "step3_cta_label",
      "label": "Step 3 CTA label",
      "default": "Next: Add extra protection"
    },
    {
      "type": "header",
      "content": "Step 4 — Protection"
    },
    {
      "type": "image_picker",
      "id": "step4_icon",
      "label": "Step 4 icon (optional)"
    },
    {
      "type": "text",
      "id": "step4_title",
      "label": "Step 4 title",
      "default": "Add extra protection"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Bundle total label",
      "default": "Bundle total:"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Add to cart button label",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "text",
      "id": "atc_note",
      "label": "Add to cart note",
      "default": "Free shipping on all orders over $50"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "camera_product",
      "name": "Camera product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "description_override",
          "label": "Short description (overrides product description)",
          "default": "camera settings"
        },
        {
          "type": "url",
          "id": "learn_more_url",
          "label": "Learn More URL"
        },
        {
          "type": "text",
          "id": "learn_more_label",
          "label": "Learn More label",
          "default": "Learn More"
        },
        {
          "type": "text",
          "id": "sale_badge_text",
          "label": "Sale badge text (e.g. Save 22%)",
          "default": "Save 22%"
        }
      ]
    },
    {
      "type": "plan_product",
      "name": "Plan product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "description_override",
          "label": "Short description",
          "default": "plan product"
        },
        {
          "type": "url",
          "id": "learn_more_url",
          "label": "Learn More URL"
        },
        {
          "type": "text",
          "id": "learn_more_label",
          "label": "Learn More label",
          "default": "Learn More"
        },
        {
          "type": "text",
          "id": "sale_badge_text",
          "label": "Sale badge text",
          "default": "Save 22%"
        }
      ]
    },
    {
      "type": "sensor_product",
      "name": "Sensor product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "description_override",
          "label": "Short description",
          "default": "Sensor product"
        },
        {
          "type": "url",
          "id": "learn_more_url",
          "label": "Learn More URL"
        },
        {
          "type": "text",
          "id": "learn_more_label",
          "label": "Learn More label",
          "default": "Learn More"
        },
        {
          "type": "text",
          "id": "sale_badge_text",
          "label": "Sale badge text",
          "default": "Save 22%"
        }
      ]
    },
    {
      "type": "protection_product",
      "name": "Protection product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "description_override",
          "label": "Short description",
          "default": "aa"
        },
        {
          "type": "url",
          "id": "learn_more_url",
          "label": "Learn More URL"
        },
        {
          "type": "text",
          "id": "learn_more_label",
          "label": "Learn More label",
          "default": "Learn More"
        },
        {
          "type": "text",
          "id": "sale_badge_text",
          "label": "Sale badge text",
          "default": "bb"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Builder",
      "blocks": [
        { "type": "camera_product" },
        { "type": "plan_product" },
        { "type": "sensor_product" },
        { "type": "protection_product" }
      ]
    }
  ]
}
{% endschema %}