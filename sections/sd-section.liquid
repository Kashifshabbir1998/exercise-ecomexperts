{{ 'sd-section.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sd-section.js' | asset_url }}" defer></script>

<!-- Google Fonts: Cormorant Garamond, Josefin Sans, Jost -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Josefin+Sans:wght@300;400;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">

<!-- Split Feature Section -->
<div
  id="shopify-section-{{ section.id }}"
  class="sd-section shopify-section"
  style="--sd-spacing-top: {{ section.settings.padding_top }}px; --sd-spacing-bottom: {{ section.settings.padding_bottom }}px;"
>
  <sd-section>
    {% render 'split-feature-block',
      section_number: section.settings.section_number,
      heading: section.settings.heading,
      body_text: section.settings.body_text,
      image: section.settings.product_image,
      image_alt: section.settings.image_alt,
      flip_layout: section.settings.flip_layout
    %}
  </sd-section>
</div>

{% schema %}
{
  "name": "Split Feature Block",
  "tag": "div",
  "class": "sd-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Split Feature Block"
    },
    {
      "type": "text",
      "id": "section_number",
      "label": "Section Number Label",
      "default": "03",
      "info": "Small label displayed above the heading (e.g. 01, 02, 03)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CLEAN INGREDIENTS"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Copy",
      "default": "<p>Our formulas are made with clean ingredients you can trust. Free from parabens, sulfates, and synthetic fragrances — every product is designed to work beautifully on every skin tone.</p>"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "Product image"
    },
    {
      "type": "checkbox",
      "id": "flip_layout",
      "label": "Flip layout (image right, text left)",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Split Feature Block",
      "category": "Custom"
    }
  ]
}
{% endschema %}