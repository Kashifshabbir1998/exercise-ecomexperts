{{ 'sd-section.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sd-section.js' | asset_url }}" defer></script>

<!-- Press Logo Bar Section -->
<div
  id="shopify-section-{{ section.id }}"
  class="sd-section shopify-section"
  style="--sd-spacing-top: {{ section.settings.padding_top }}px; --sd-spacing-bottom: {{ section.settings.padding_bottom }}px;"
>
  <sd-section>
    {%- if section.settings.eyebrow_text != blank -%}
      <p class="sd-section__eyebrow">{{ section.settings.eyebrow_text }}</p>
    {%- endif -%}

    <!-- Desktop: static row | Mobile: Swiper carousel -->
    <div class="sd-section__inner">

      <!-- Swiper wrapper (used on mobile, static on desktop via CSS) -->
      <div class="swiper sd-section__swiper">
        <div class="swiper-wrapper sd-section__logos">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'press_logo' -%}
                <div class="swiper-slide sd-section__logo-slide" {{ block.shopify_attributes }}>
                  {%- if block.settings.logo_image != blank -%}
                    <div class="sd-section__logo-image-wrap">
                      {{
                        block.settings.logo_image
                        | image_url: width: 300
                        | image_tag:
                          loading: 'lazy',
                          widths: '150,300',
                          alt: block.settings.publication_name,
                          class: 'sd-section__logo-img',
                          width: 150,
                          height: 60
                      }}
                    </div>
                  {%- else -%}
                    <!-- Text-based logo mimicking publication brand typography -->
                    <span
                      class="sd-section__logo-text sd-section__logo-text--{{ block.settings.style }}"
                      aria-label="{{ block.settings.publication_name }}"
                    >
                      {{- block.settings.publication_name -}}
                    </span>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>

    </div>
  </sd-section>
</div>

{% schema %}
{
  "name": "Press Logo Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Press Logo Bar"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow label",
      "default": "As Seen In"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "press_logo",
      "name": "Publication",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "publication_name",
          "label": "Publication name",
          "default": "Publication"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo image (optional)"
        },
        {
          "type": "url",
          "id": "logo_link",
          "label": "Link (optional)"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Typography style",
          "default": "italic-serif",
          "options": [
            { "value": "italic-serif", "label": "Italic serif (Allure)" },
            { "value": "spaced-caps", "label": "Spaced caps (Vogue)" },
            { "value": "bold-serif", "label": "Bold serif (NYT)" },
            { "value": "italic-spaced", "label": "Italic spaced (Glamour)" },
            { "value": "spaced-sans", "label": "Spaced sans (Byrdie)" },
            { "value": "italic-sans", "label": "Italic sans (InStyle)" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Logo Bar",
      "blocks": [
        {
          "type": "press_logo",
          "settings": {
            "publication_name": "Allure",
            "style": "italic-serif"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "publication_name": "VOGUE",
            "style": "spaced-caps"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "publication_name": "The New York Times",
            "style": "bold-serif"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "publication_name": "Glamour",
            "style": "italic-spaced"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "publication_name": "BYRDIE",
            "style": "spaced-sans"
          }
        },
        {
          "type": "press_logo",
          "settings": {
            "publication_name": "InStyle",
            "style": "italic-sans"
          }
        }
      ]
    }
  ]
}
{% endschema %}