{{ 'sd-section.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sd-section.js' | asset_url }}" defer></script>

<!-- Two-Panel Hero Section: Left = product image, Right = text content + CTA -->
<div
  id="shopify-section-{{ section.id }}"
  class="sd-section shopify-section"
  style="--sd-spacing-top: {{ section.settings.padding_top }}px; --sd-spacing-bottom: {{ section.settings.padding_bottom }}px; --sd-left-bg: {{ section.settings.left_panel_bg }}; --sd-right-bg: {{ section.settings.right_panel_bg }};"
>
  <sd-section-hero data-section-id="{{ section.id }}">

    <div class="sd-section__grid">

      <!-- LEFT PANEL: Product Image -->
      <div class="sd-section__left-panel">
        <div class="sd-section__image-wrap">
          {%- if section.settings.product_image != blank -%}
            {%- assign img_alt = section.settings.product_image_alt | default: section.settings.heading | escape -%}
            {{ section.settings.product_image | image_url: width: 1200 | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400,600,800,1000,1200',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: img_alt,
              class: 'sd-section__product-image',
              width: 1200,
              height: 900
            }}
          {%- else -%}
            <img
              src="{{ '4f5cde8fc7eec6018c84bf23227042c143d86bd4.webp' | asset_url }}"
              alt="{{ section.settings.product_image_alt | default: 'Product image' }}"
              loading="eager"
              fetchpriority="high"
              width="1200"
              height="900"
              class="sd-section__product-image"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- RIGHT PANEL: Text Content -->
      <div class="sd-section__right-panel">
        <div class="sd-section__content">

          <!-- Eyebrow label -->
          {%- unless section.settings.eyebrow == blank -%}
            <p class="sd-section__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endunless -%}

          <!-- Main heading -->
          {%- unless section.settings.heading == blank -%}
            <h2 class="sd-section__heading">{{ section.settings.heading }}</h2>
          {%- endunless -%}

          <!-- Body copy -->
          {%- unless section.settings.body_copy == blank -%}
            <div class="sd-section__body">{{ section.settings.body_copy }}</div>
          {%- endunless -%}

          <!-- Star rating + review count -->
          <div class="sd-section__reviews">
            {% render 'sd-snip-star-rating',
              rating: section.settings.star_rating,
              review_count: section.settings.review_count,
              badge_text: section.settings.badge_text
            %}
          </div>

          <!-- CTA Button -->
          {%- unless section.settings.cta_label == blank -%}
            <a
              href="{{ section.settings.cta_url | default: '#' }}"
              class="sd-section__cta"
              aria-label="{{ section.settings.cta_label }}"
            >
              {{ section.settings.cta_label }}
            </a>
          {%- endunless -%}

        </div>
      </div>
      <!-- END RIGHT PANEL -->

    </div>

  </sd-section-hero>
</div>

{% schema %}
{
  "name": "Two-Panel Hero",
  "tag": "section",
  "class": "sd-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Two-Panel Hero"
    },
    {
      "type": "header",
      "content": "Left Panel — Product Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image",
      "info": "Displays on the left panel. Falls back to bundled Figma asset if blank."
    },
    {
      "type": "text",
      "id": "product_image_alt",
      "label": "Product Image Alt Text",
      "placeholder": "e.g. Jones Road Mini Miracle Balm open container",
      "default": "Jones Road Mini Miracle Balm"
    },
    {
      "type": "color",
      "id": "left_panel_bg",
      "label": "Left Panel Background Color",
      "default": "#f0efed"
    },
    {
      "type": "header",
      "content": "Right Panel — Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "placeholder": "e.g. THE 30-SECOND MAKEUP ROUTINE",
      "default": "THE 30-SECOND MAKEUP ROUTINE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "placeholder": "e.g. 5 reasons busy women are switching to Mini Miracle Balm",
      "default": "5 reasons busy women are switching to Mini Miracle Balm"
    },
    {
      "type": "richtext",
      "id": "body_copy",
      "label": "Body Copy",
      "default": "<p>You run a packed calendar. Your makeup should keep up. One swipe of sheer, buildable color for cheeks and lips — and you look polished without looking done.</p>"
    },
    {
      "type": "color",
      "id": "right_panel_bg",
      "label": "Right Panel Background Color",
      "default": "#f5ede0"
    },
    {
      "type": "header",
      "content": "Star Rating & Reviews"
    },
    {
      "type": "number",
      "id": "star_rating",
      "label": "Star Rating (0–5)",
      "default": 5,
      "info": "Displayed as filled star icons. Enter a whole number from 0 to 5."
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count Text",
      "placeholder": "e.g. 75,900+",
      "default": "75,900+"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "placeholder": "e.g. #1 bestseller",
      "default": "#1 bestseller"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "placeholder": "e.g. SHOP MINI MIRACLE BALM",
      "default": "SHOP MINI MIRACLE BALM"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link",
      "info": "Links to the product or collection page"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Two-Panel Hero"
    }
  ]
}
{% endschema %}