{{ 'custom-styles.css' | asset_url | stylesheet_tag }}

<div
  class="custom-banner {% if section.settings.content_alignment == 'center' %}text-center{% endif %}"
  style="background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}'); background-color: {{ section.settings.bg_color }};"
>
  <div class="custom-section-wrapper">
    <div
      class="custom-banner__content"
      style="{% if section.settings.content_alignment == 'center' %}margin: 0 auto; text-align: center;{% endif %}"
    >
      {%- if section.settings.header_text != blank -%}
        <h2 class="custom-banner__title">{{ section.settings.header_text }}</h2>
      {%- endif -%}

      {%- if section.settings.sub_text != blank -%}
        <div class="custom-banner__text rte">
          {{ section.settings.sub_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="custom-banner__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .custom-banner__text strong,
  .custom-banner__text em,
  .custom-banner__text span[style*="color"] {
    color: {{ section.settings.highlight_text_color }} !important;
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "sub_text",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "Highlight Text Color",
      "default": "#ff0000",
      "info": "Color for bold/italic/highlighted text in the description."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
