<style>
    /* ============================================================
   Alvex Studio — llll.css
   ============================================================ */

/* ── Custom Properties ──────────────────────────────────────── */
:root {
  --color-bg:             #0d0618;
  --color-bg-nav:         #0e0818;
  --color-purple:         #7c3aed;
  --color-purple-light:   #9d5cf6;
  --color-purple-dark:    #4a1772;
  --color-purple-glow:    rgba(124, 58, 237, 0.45);
  --color-purple-border:  rgba(124, 58, 237, 0.32);
  --color-white:          #ffffff;
  --color-text-muted:     rgba(255, 255, 255, 0.50);
  --color-text-body:      rgba(255, 255, 255, 0.70);
  --color-circle-line:    rgba(255, 255, 255, 0.07);

  --font-heading: 'Space Grotesk', system-ui, sans-serif;
  --font-body:    'Space Grotesk', system-ui, sans-serif;
  --font-accent:  'Outfit', 'Space Grotesk', system-ui, sans-serif;

  --nav-height:         68px;
  --px-mobile:          20px;
  --px-desktop:         60px;
}

/* ── Reset ──────────────────────────────────────────────────── */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--color-bg);
  color: var(--color-white);
  font-family: var(--font-body);
  line-height: 1.6;
  overflow-x: hidden;
}

body.nav-open {
  overflow: hidden;
}

/* ── Responsive Visibility Utilities ───────────────────────── */
/* Mobile base: hidden-mobile = hide, hidden-desktop = show */
.hidden-mobile {
  display: none !important;
}

.hidden-desktop {
  display: flex !important;
}

@media (min-width: 750px) {
  .hidden-mobile {
    display: flex !important;
  }
  .hidden-desktop {
    display: none !important;
  }
}

/* ── Page Wrapper ───────────────────────────────────────────── */
.llll-page {
  background-color: var(--color-bg);
  min-height: 100vh;
}

.llll-section-wrapper {
  display: block;
}

/* ============================================================
   SITE HEADER
   ============================================================ */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background-color: var(--color-bg-nav);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  height: var(--nav-height);
}

.site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 0 var(--px-mobile);
  position: relative;
}

@media (min-width: 750px) {
  .site-header__inner {
    padding: 0 var(--px-desktop);
  }
}

/* Logo */
.site-header__logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  flex-shrink: 0;
  z-index: 1;
}

.site-header__logo-icon {
  display: flex;
  align-items: center;
  gap: 2px;
}

.site-header__logo-bracket {
  font-family: var(--font-heading);
  font-size: 22px;
  font-weight: 300;
  color: var(--color-white);
  line-height: 1;
  letter-spacing: -1px;
}

.site-header__logo-dot-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 14px;
  height: 14px;
}

.site-header__logo-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--color-purple);
  box-shadow: 0 0 8px var(--color-purple-glow);
}

.site-header__logo-text-wrap {
  display: flex;
  flex-direction: column;
  gap: 1px;
  line-height: 1;
}

.site-header__logo-name {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  color: var(--color-white);
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.site-header__logo-sub {
  font-family: var(--font-accent);
  font-size: 9px;
  font-weight: 400;
  color: var(--color-text-muted);
  letter-spacing: 2.5px;
  text-transform: uppercase;
}

/* Desktop nav — centered absolutely */
.site-header__nav {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 0;
  bottom: 0;
  align-items: center;
}

.site-header__nav-list {
  display: flex;
  align-items: center;
  gap: 30px;
  list-style: none;
}

.site-header__nav-link {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.70);
  text-decoration: none;
  letter-spacing: 0.2px;
  padding-bottom: 2px;
  transition: color 0.2s ease;
}

.site-header__nav-link:hover {
  color: var(--color-white);
}

.site-header__nav-link--active {
  color: var(--color-white);
  font-weight: 500;
  border-bottom: 1.5px solid var(--color-white);
}

/* Floating cursor dot */
.site-header__float-dot {
  position: fixed;
  top: 0;
  left: 0;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: var(--color-purple);
  pointer-events: none;
  z-index: 9999;
  box-shadow: 0 0 10px var(--color-purple-glow), 0 0 22px var(--color-purple-glow);
  will-change: transform;
}

/* Nav CTA */
.site-header__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-purple);
  color: var(--color-white);
  text-decoration: none;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  padding: 10px 22px;
  border-radius: 6px;
  letter-spacing: 0.2px;
  flex-shrink: 0;
  white-space: nowrap;
  transition: background-color 0.2s ease, box-shadow 0.2s ease;
  z-index: 1;
}

.site-header__cta:hover {
  background-color: var(--color-purple-light);
  box-shadow: 0 0 20px var(--color-purple-glow);
}

/* Hamburger */
.site-header__hamburger {
  background: none;
  border: none;
  cursor: pointer;
  flex-direction: column;
  gap: 5px;
  padding: 8px;
  align-items: center;
  justify-content: center;
}

.site-header__hamburger-bar {
  display: block;
  width: 22px;
  height: 2px;
  background-color: var(--color-white);
  border-radius: 2px;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

/* Mobile nav drawer */
.site-header__mobile-nav {
  position: fixed;
  top: var(--nav-height);
  left: 0;
  right: 0;
  background-color: var(--color-bg-nav);
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  padding: 12px var(--px-mobile) 24px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-6px);
  transition: opacity 0.25s ease, transform 0.25s ease;
  z-index: 999;
  flex-direction: column;
}

.site-header__mobile-nav.is-open {
  opacity: 1;
  pointer-events: all;
  transform: translateY(0);
}

.site-header__mobile-nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.site-header__mobile-nav-link {
  display: block;
  padding: 13px 0;
  font-size: 16px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.80);
  text-decoration: none;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  transition: color 0.2s ease;
}

.site-header__mobile-nav-link:hover {
  color: var(--color-white);
}

.site-header__mobile-nav-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-purple);
  color: var(--color-white);
  text-decoration: none;
  font-size: 15px;
  font-weight: 600;
  padding: 13px 24px;
  border-radius: 6px;
  margin-top: 16px;
  width: 100%;
  transition: background-color 0.2s ease;
}

.site-header__mobile-nav-cta:hover {
  background-color: var(--color-purple-light);
}

/* ============================================================
   HERO SECTION
   ============================================================ */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-top: var(--nav-height);
  overflow: hidden;
  background-color: var(--color-bg);
}

/* Dot grid background */
.hero__bg-grid {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.065) 1px, transparent 1px);
  background-size: 28px 28px;
  pointer-events: none;
}

/* Purple glow overlay */
.hero__glow {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: radial-gradient(
    ellipse 55% 65% at 78% 50%,
    rgba(76, 29, 149, 0.28) 0%,
    transparent 68%
  );
  pointer-events: none;
}

/* Inner two-column layout */
.hero__inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  padding: 64px var(--px-mobile) 128px;
  gap: 48px;
}

@media (min-width: 750px) {
  .hero__inner {
    flex-direction: row;
    align-items: center;
    padding: 80px var(--px-desktop) 140px;
    gap: 0;
  }
}

/* Left content column */
.hero__content {
  display: flex;
  flex-direction: column;
  gap: 26px;
  width: 100%;
  z-index: 2;
}

@media (min-width: 750px) {
  .hero__content {
    flex: 0 0 52%;
    max-width: 52%;
    gap: 28px;
  }
}

/* ── Hero Badge ─────────────────────────────────────────────── */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background-color: rgba(74, 23, 114, 0.22);
  border: 1px solid var(--color-purple-border);
  border-radius: 100px;
  padding: 7px 16px 7px 10px;
  width: fit-content;
}

.hero-badge__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-purple);
  box-shadow: 0 0 8px var(--color-purple-glow);
  flex-shrink: 0;
}

.hero-badge__text {
  font-family: var(--font-accent);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 1.8px;
  color: rgba(255, 255, 255, 0.78);
  text-transform: uppercase;
}

/* ── Headline ───────────────────────────────────────────────── */
.hero__headline {
  font-family: var(--font-heading);
  font-size: clamp(50px, 7vw, 92px);
  font-weight: 700;
  line-height: 1.02;
  letter-spacing: -2px;
}

.hero__headline--white {
  color: var(--color-white);
}

.hero__headline--purple {
  color: var(--color-purple-light);
}

/* ── Body Text ──────────────────────────────────────────────── */
.hero__body {
  font-family: var(--font-body);
  font-size: clamp(14px, 1.4vw, 17px);
  font-weight: 400;
  color: var(--color-text-body);
  line-height: 1.65;
  max-width: 430px;
}

/* ── CTA Buttons ────────────────────────────────────────────── */
.hero__ctas {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
}

.hero__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  border-radius: 7px;
  padding: 13px 26px;
  transition: background-color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  white-space: nowrap;
}

.hero__cta--primary {
  background-color: var(--color-purple);
  color: var(--color-white);
  border: 1.5px solid var(--color-purple);
}

.hero__cta--primary:hover {
  background-color: var(--color-purple-light);
  border-color: var(--color-purple-light);
  box-shadow: 0 0 26px var(--color-purple-glow);
}

.hero__cta--secondary {
  background-color: transparent;
  color: var(--color-white);
  border: 1.5px solid rgba(255, 255, 255, 0.28);
}

.hero__cta--secondary:hover {
  border-color: rgba(255, 255, 255, 0.60);
  background-color: rgba(255, 255, 255, 0.05);
}

/* ── Stats Bar ──────────────────────────────────────────────── */
.stats-bar {
  display: flex;
  align-items: flex-start;
  gap: 28px;
  flex-wrap: wrap;
  padding-top: 8px;
}

@media (min-width: 750px) {
  .stats-bar {
    gap: 38px;
  }
}

.stats-bar__item {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.stats-bar__value {
  font-family: var(--font-heading);
  font-size: clamp(24px, 2.8vw, 34px);
  font-weight: 700;
  color: var(--color-white);
  line-height: 1.1;
  letter-spacing: -0.5px;
}

.stats-bar__label {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 400;
  color: var(--color-text-muted);
  letter-spacing: 0.4px;
}

/* ── Decorative Circular Graphic ────────────────────────────── */
/* Hidden on mobile, shown on desktop */
.hero__decoration {
  display: none;
  position: absolute;
  right: -4%;
  top: 50%;
  transform: translateY(-50%);
  width: 580px;
  height: 580px;
  pointer-events: none;
  z-index: 1;
}

@media (min-width: 750px) {
  .hero__decoration {
    display: block;
  }
}

@media (min-width: 1100px) {
  .hero__decoration {
    width: 660px;
    height: 660px;
    right: -2%;
  }
}

@media (min-width: 1400px) {
  .hero__decoration {
    width: 720px;
    height: 720px;
    right: 0;
  }
}

/* Circles */
.hero__circle {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  border: 1px solid var(--color-circle-line);
}

.hero__circle--outer {
  width: 100%;
  height: 100%;
}

.hero__circle--mid {
  width: 78%;
  height: 78%;
  border-color: rgba(255, 255, 255, 0.05);
}

.hero__circle--inner {
  width: 54%;
  height: 54%;
  border-color: rgba(255, 255, 255, 0.05);
}

/* Crosshair lines */
.hero__crosshair {
  position: absolute;
  background-color: rgba(255, 255, 255, 0.055);
}

.hero__crosshair--h {
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  transform: translateY(-50%);
}

.hero__crosshair--v {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
  transform: translateX(-50%);
}

/* Central radial glow */
.hero__center-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 340px;
  height: 340px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(124, 58, 237, 0.60) 0%,
    rgba(124, 58, 237, 0.22) 38%,
    transparent 68%
  );
  pointer-events: none;
  will-change: transform;
}

/* Logo mark centered in circle */
.hero__logo-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  z-index: 2;
}

.hero__logo-bracket {
  font-family: var(--font-heading);
  font-size: 56px;
  font-weight: 200;
  color: var(--color-white);
  line-height: 1;
  letter-spacing: -3px;
  opacity: 0.90;
}

.hero__logo-dot-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
}

.hero__logo-dot {
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background-color: var(--color-white);
  box-shadow:
    0 0 12px rgba(255, 255, 255, 0.95),
    0 0 28px rgba(200, 180, 255, 0.75),
    0 0 50px rgba(124, 58, 237, 0.55);
}

/* ── Slide Counter ──────────────────────────────────────────── */
.hero__slide-counter {
  position: absolute;
  bottom: 30px;
  left: var(--px-mobile);
  display: flex;
  align-items: center;
  font-family: var(--font-accent);
  font-size: 12px;
  font-weight: 500;
  color: var(--color-text-muted);
  letter-spacing: 1.5px;
  z-index: 2;
  transition: opacity 0.3s ease;
}

@media (min-width: 750px) {
  .hero__slide-counter {
    left: var(--px-desktop);
  }
}

.hero__slide-sep {
  margin: 0 3px;
}

/* ── Scroll Indicator ───────────────────────────────────────── */
.hero__scroll-indicator {
  position: absolute;
  bottom: 30px;
  right: var(--px-mobile);
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-accent);
  font-size: 11px;
  font-weight: 500;
  color: var(--color-text-muted);
  letter-spacing: 2px;
  text-transform: uppercase;
  z-index: 2;
  transition: opacity 0.3s ease;
}

@media (min-width: 750px) {
  .hero__scroll-indicator {
    right: var(--px-desktop);
  }
}

.hero__scroll-arrow {
  font-size: 12px;
}

/* ── Focus States ───────────────────────────────────────────── */
.site-header__nav-link:focus-visible,
.site-header__cta:focus-visible,
.site-header__logo:focus-visible,
.hero__cta:focus-visible,
.site-header__hamburger:focus-visible,
.site-header__mobile-nav-link:focus-visible,
.site-header__mobile-nav-cta:focus-visible {
  outline: 2px solid var(--color-purple-light);
  outline-offset: 3px;
  border-radius: 4px;
}
</style>
<script>
    // Alvex Studio — llll.js
(function () {
  'use strict';

  // ── Floating Cursor Dot ─────────────────────────────────────────────────
  const cursorDot = document.querySelector('.site-header__float-dot');
  if (cursorDot && window.matchMedia('(min-width: 750px)').matches) {
    let mouseX = window.innerWidth / 2;
    let mouseY = 34;
    let curX = mouseX;
    let curY = mouseY;

    document.addEventListener('mousemove', function (e) {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    (function animateDot() {
      curX += (mouseX - curX) * 0.12;
      curY += (mouseY - curY) * 0.12;
      cursorDot.style.transform = 'translate(' + curX + 'px, ' + curY + 'px) translate(-50%, -50%)';
      requestAnimationFrame(animateDot);
    })();
  }

  // ── Mobile Nav Toggle ──────────────────────────────────────────────────
  const hamburger = document.querySelector('.site-header__hamburger');
  const mobileNavs = document.querySelectorAll('.site-header__mobile-nav');

  if (hamburger && mobileNavs.length) {
    hamburger.addEventListener('click', function () {
      const isOpen = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', String(!isOpen));
      mobileNavs.forEach(function (nav) {
        nav.setAttribute('aria-hidden', String(isOpen));
        nav.classList.toggle('is-open', !isOpen);
      });
      document.body.classList.toggle('nav-open', !isOpen);
    });
  }

  // ── Hero Entrance Animations ───────────────────────────────────────────
  function initHeroAnimations() {
    var elements = document.querySelectorAll(
      '.hero-badge, .hero__headline, .hero__body, .hero__ctas, .stats-bar, .hero__decoration'
    );
    elements.forEach(function (el, index) {
      el.style.opacity = '0';
      el.style.transform = 'translateY(22px)';
      el.style.transition =
        'opacity 0.7s ease ' + index * 0.11 + 's, transform 0.7s ease ' + index * 0.11 + 's';
    });
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        elements.forEach(function (el) {
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        });
      });
    });
  }

  // ── Decorative Glow Pulse ──────────────────────────────────────────────
  function initGlowPulse() {
    var glow = document.querySelector('.hero__center-glow');
    if (!glow) return;
    var scale = 1;
    var dir = 1;
    var frame = 0;
    (function pulse() {
      frame++;
      if (frame % 2 === 0) {
        scale += dir * 0.0025;
        if (scale > 1.07) dir = -1;
        if (scale < 0.93) dir = 1;
        glow.style.transform = 'translate(-50%, -50%) scale(' + scale + ')';
      }
      requestAnimationFrame(pulse);
    })();
  }

  // ── Scroll Indicator Fade ──────────────────────────────────────────────
  function initScrollFade() {
    var scrollEl = document.querySelector('.hero__scroll-indicator');
    var counterEl = document.querySelector('.hero__slide-counter');
    if (!scrollEl && !counterEl) return;
    window.addEventListener('scroll', function () {
      var opacity = Math.max(0, 1 - window.scrollY / 180);
      if (scrollEl) scrollEl.style.opacity = opacity;
      if (counterEl) counterEl.style.opacity = opacity;
    }, { passive: true });
  }

  // ── Init ───────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    initHeroAnimations();
    initGlowPulse();
    initScrollFade();
  });

})();
</script>

