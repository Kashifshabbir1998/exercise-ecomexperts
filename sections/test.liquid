{% comment %}
  Section: Teeee Homepage
  Description: This section provides a comprehensive homepage layout including hero, about, news, services, video, and contact call-to-action areas.
{% endcomment %}

{% comment %} <link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}" media="print" onload="this.media='all'"> {% endcomment %}
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.css" integrity="sha512-rd0qOHVMOcez6pLWPVFIv7EfSdGKLt+eafXh4RO/12Fgr41hDQxfGvoi1Vy55QIVcQEujUE1LQrATCLl2Fs+ag==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<noscript><link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}"></noscript>

<style>
  .section-teeeee__hero-content {
    --text-color: {{ section.settings.hero_text_color.rgb }};
  }
  .section-teeeee__hero-overlay {
    background-color: rgba(0,0,0,{{ section.settings.hero_overlay_opacity | divided_by: 100.0 }});
  }
  .section-teeeee__video-overlay {
    background-color: rgba(0,0,0,{{ section.settings.video_overlay_opacity | divided_by: 100.0 }});
  }

  .section-teeeee {
  overflow: hidden;
}

.section-teeeee__hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 500px;
  padding: 80px 0;
  color: var(--text-color);
}

.section-teeeee__hero-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 0;
}

.section-teeeee__hero-image,
.section-teeeee__hero-video,
.section-teeeee__hero-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

.section-teeeee__hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.section-teeeee__hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 var(--page-width-padding);
}

.section-teeeee__hero-heading {
  font-family: var(--font-heading-family);
  font-size: 3.2rem;
  line-height: 1.2;
  margin-bottom: 20px;
  color: var(--text-color);
}

.section-teeeee__hero .button--primary {
  background-color: var(--color-base-accent-1);
  color: var(--color-base-solid-button-labels);
  border-color: var(--color-base-accent-1);
}

.section-teeeee__hero .button--primary:hover {
  background-color: var(--color-base-accent-2);
  border-color: var(--color-base-accent-2);
}

/* About Section */
.section-teeeee__about {
  padding: 60px 0;
  text-align: center;
}

.section-teeeee__about-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 var(--page-width-padding);
}

.section-teeeee__about-heading {
  font-family: var(--font-heading-family);
  font-size: 2.8rem;
  line-height: 1.3;
  margin-bottom: 25px;
}

.section-teeeee__about-text {
  font-size: 1.6rem;
  line-height: 1.6;
  margin-bottom: 30px;
}

.section-teeeee__about .button--secondary {
  background-color: transparent;
  color: var(--color-base-text);
  border: 1px solid var(--color-base-text);
}

.section-teeeee__about .button--secondary:hover {
  background-color: var(--color-base-text);
  color: var(--color-base-background-1);
}

/* News & Events Section */
.section-teeeee__news {
  padding: 60px 0;
}

.section-teeeee__news-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  padding: 0 var(--page-width-padding);
}

.section-teeeee__news-heading {
  font-family: var(--font-heading-family);
  font-size: 2.8rem;
  line-height: 1.3;
  margin: 0;
}

.section-teeeee__news-slider-wrapper {
  position: relative;
  padding: 0 var(--page-width-padding); /* Adjust for partial slide visibility */
}

.section-teeeee__news-card {
  background-color: var(--color-base-background-2);
  border-radius: var(--media-border-radius);
  overflow: hidden;
  height: auto; /* Ensure cards adjust to content */
  display: flex;
  flex-direction: column;
}

.section-teeeee__news-card-link {
  display: flex;
  flex-direction: column;
  height: 100%;
  text-decoration: none;
  color: inherit;
}

.section-teeeee__news-card-image,
.section-teeeee__news-card-image-placeholder {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.section-teeeee__news-card-content {
  padding: 20px;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
}

.section-teeeee__news-card-date {
  font-size: 1.2rem;
  color: var(--color-base-text);
  opacity: 0.7;
  margin-bottom: 10px;
  text-transform: uppercase;
}

.section-teeeee__news-card-title {
  font-family: var(--font-heading-family);
  font-size: 2rem;
  line-height: 1.4;
  margin-bottom: 15px;
  flex-grow: 1;
}

.section-teeeee__news-card-read-more {
  display: flex;
  align-items: center;
  font-size: 1.4rem;
  font-weight: bold;
  color: var(--color-base-accent-1);
}

.section-teeeee__news-card-read-more .icon-arrow {
  width: 12px;
  height: 12px;
  margin-left: 8px;
  transition: transform 0.2s ease-in-out;
}

.section-teeeee__news-card-link:hover .section-teeeee__news-card-read-more .icon-arrow {
  transform: translateX(5px);
}

.section-teeeee__news-empty {
  text-align: center;
  padding: 40px var(--page-width-padding);
  font-size: 1.6rem;
}

.section-teeeee__news-view-all-mobile {
  text-align: center;
  margin-top: 40px;
}

/* Swiper Navigation */
.section-teeeee__news-slider-wrapper .swiper-button-prev,
.section-teeeee__news-slider-wrapper .swiper-button-next {
  color: var(--color-base-text);
  width: 40px;
  height: 40px;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease-in-out;
  top: 50%;
  transform: translateY(-50%);
}

.section-teeeee__news-slider-wrapper .swiper-button-prev:hover,
.section-teeeee__news-slider-wrapper .swiper-button-next:hover {
  background-color: rgba(255, 255, 255, 1);
}

.section-teeeee__news-slider-wrapper .swiper-button-prev::after,
.section-teeeee__news-slider-wrapper .swiper-button-next::after {
  content: none; /* Remove default Swiper arrows */
}

.section-teeeee__news-slider-wrapper .swiper-button-prev .icon-arrow {
  transform: rotate(180deg);
}

/* Services & Offerings Section */
.section-teeeee__services {
  padding: 60px 0;
}

.section-teeeee__services-heading {
  font-family: var(--font-heading-family);
  font-size: 2.8rem;
  line-height: 1.3;
  text-align: center;
  margin-bottom: 40px;
  padding: 0 var(--page-width-padding);
}

.section-teeeee__services-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 30px;
  padding: 0 var(--page-width-padding);
}

.section-teeeee__service-card {
  background-color: var(--color-base-background-1);
  border-radius: var(--media-border-radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  text-align: center;
}

.section-teeeee__service-card-image,
.section-teeeee__service-card-image-placeholder {
  width: 100%;
  height: 250px;
  object-fit: cover;
}

.section-teeeee__service-card-content {
  padding: 30px;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-teeeee__service-card-title {
  font-family: var(--font-heading-family);
  font-size: 2.2rem;
  line-height: 1.3;
  margin-bottom: 15px;
}

.section-teeeee__service-card-description {
  font-size: 1.6rem;
  line-height: 1.6;
  margin-bottom: 25px;
  flex-grow: 1;
}

.section-teeeee__service-card .button--link {
  color: var(--color-base-accent-1);
  font-weight: bold;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.section-teeeee__service-card .button--link .icon-arrow {
  width: 12px;
  height: 12px;
  margin-left: 8px;
  transition: transform 0.2s ease-in-out;
}

.section-teeeee__service-card .button--link:hover .icon-arrow {
  transform: translateX(5px);
}

.section-teeeee__services-empty {
  text-align: center;
  padding: 40px var(--page-width-padding);
  font-size: 1.6rem;
}

/* Video Section */
.section-teeeee__video {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 450px;
  padding: 80px 0;
  color: var(--color-base-text);
}

.section-teeeee__video-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 0;
}

.section-teeeee__video-image,
.section-teeeee__video-placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

.section-teeeee__video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.section-teeeee__video-content {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
  padding: 0 var(--page-width-padding);
}

.section-teeeee__video-heading {
  font-family: var(--font-heading-family);
  font-size: 3.2rem;
  line-height: 1.2;
  margin-bottom: 30px;
  color: var(--color-base-text);
}

.section-teeeee__video .button--play {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-base-accent-1);
  color: var(--color-base-solid-button-labels);
  border-radius: 50px;
  padding: 15px 30px;
  font-size: 1.6rem;
  font-weight: bold;
  text-decoration: none;
  transition: background-color 0.2s ease-in-out;
}

.section-teeeee__video .button--play:hover {
  background-color: var(--color-base-accent-2);
}

.section-teeeee__video .button--play .icon-play {
  width: 24px;
  height: 24px;
  margin-right: 10px;
}

/* Contact Call to Action Section */
.section-teeeee__contact {
  padding: 60px 0;
  text-align: center;
}

.section-teeeee__contact-wrapper {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 var(--page-width-padding);
}

.section-teeeee__contact-heading {
  font-family: var(--font-heading-family);
  font-size: 2.8rem;
  line-height: 1.3;
  margin-bottom: 30px;
}

.section-teeeee__contact .button--primary {
  background-color: var(--color-base-accent-1);
  color: var(--color-base-solid-button-labels);
  border-color: var(--color-base-accent-1);
}

.section-teeeee__contact .button--primary:hover {
  background-color: var(--color-base-accent-2);
  border-color: var(--color-base-accent-2);
}

/* Responsive styles */
@media screen and (min-width: 750px) {
  .section-teeeee__hero {
    min-height: 700px;
    padding: 120px 0;
  }

  .section-teeeee__hero-heading {
    font-size: 5rem;
  }

  .section-teeeee__about {
    padding: 100px 0;
  }

  .section-teeeee__about-heading {
    font-size: 3.8rem;
  }

  .section-teeeee__news {
    padding: 100px 0;
  }

  .section-teeeee__news-heading {
    font-size: 3.8rem;
  }

  .section-teeeee__news-slider-wrapper {
    padding: 0; /* No padding needed on desktop as slides are fully visible */
  }

  .section-teeeee__news-slider-wrapper .swiper-button-prev {
    left: -60px; /* Position arrows outside the content area */
  }

  .section-teeeee__news-slider-wrapper .swiper-button-next {
    right: -60px; /* Position arrows outside the content area */
  }

  .section-teeeee__services {
    padding: 100px 0;
  }

  .section-teeeee__services-heading {
    font-size: 3.8rem;
  }

  .section-teeeee__services-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .section-teeeee__video {
    min-height: 550px;
    padding: 100px 0;
  }

  .section-teeeee__video-heading {
    font-size: 4.5rem;
  }

  .section-teeeee__contact {
    padding: 100px 0;
  }

  .section-teeeee__contact-heading {
    font-size: 3.8rem;
  }
}

.hidden-mobile {
  display: none !important;
}

@media screen and (min-width: 750px) {
  .hidden-mobile {
    display: flex !important; /* or block, inline-block depending on element */
  }
}

.hidden-desktop {
  display: none !important;
}

@media screen and (max-width: 749px) {
  .hidden-desktop {
    display: block !important; /* or flex, inline-block depending on element */
  }
}
</style>

<div class="section-teeeee color-{{ section.settings.hero_color_scheme }}" data-section-id="{{ section.id }}">
  {# Hero Section #}
  <section class="section-teeeee__hero gradient">
    <div class="section-teeeee__hero-background">
      {% if section.settings.hero_video_enable and section.settings.hero_video_url != blank %}
        <video class="section-teeeee__hero-video" autoplay loop muted playsinline poster="{{ section.settings.hero_image | image_url: width: 1920 }}">
          <source src="{{ section.settings.hero_video_url }}" type="video/mp4">
          <!-- PLACEHOLDER: Add other video formats for broader browser support if needed -->
        </video>
      {% elsif section.settings.hero_image != blank %}
        {{ section.settings.hero_image | image_url: width: 1920 | image_tag: loading: 'eager', class: 'section-teeeee__hero-image', alt: section.settings.hero_image.alt | default: section.settings.hero_heading | strip_html }}
      {% else %}
        <div class="section-teeeee__hero-placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
      <div class="section-teeeee__hero-overlay"></div>
    </div>
    <div class="section-teeeee__hero-content page-width">
      {% if section.settings.hero_heading != blank %}
        <h1 class="section-teeeee__hero-heading">{{ section.settings.hero_heading }}</h1>
      {% endif %}
      {% if section.settings.hero_button_text != blank and section.settings.hero_button_link != blank %}
        <a href="{{ section.settings.hero_button_link }}" class="button button--primary">
          {{ section.settings.hero_button_text }}
        </a>
      {% endif %}
    </div>
  </section>

  {# About Section #}
  <section class="section-teeeee__about color-{{ section.settings.about_color_scheme }} gradient">
    <div class="page-width section-teeeee__about-wrapper">
      {% if section.settings.about_heading != blank %}
        <h2 class="section-teeeee__about-heading">{{ section.settings.about_heading }}</h2>
      {% endif %}
      {% if section.settings.about_text != blank %}
        <div class="section-teeeee__about-text rte">
          {{ section.settings.about_text }}
        </div>
      {% endif %}
      {% if section.settings.about_button_text != blank and section.settings.about_button_link != blank %}
        <a href="{{ section.settings.about_button_link }}" class="button button--secondary">
          {{ section.settings.about_button_text }}
        </a>
      {% endif %}
    </div>
  </section>

  {# News & Events Section #}
  <section class="section-teeeee__news color-{{ section.settings.news_color_scheme }} gradient">
    <div class="page-width">
      <div class="section-teeeee__news-header">
        {% if section.settings.news_heading != blank %}
          <h2 class="section-teeeee__news-heading">{{ section.settings.news_heading }}</h2>
        {% endif %}
        {% if section.settings.news_view_all_text != blank and section.settings.news_view_all_link != blank %}
          <a href="{{ section.settings.news_view_all_link }}" class="button button--tertiary hidden-mobile">
            {{ section.settings.news_view_all_text }}
          </a>
        {% endif %}
      </div>

      {% assign blog = blogs[section.settings.news_blog] %}
      {% if blog != blank and blog.articles.size > 0 %}
        <teeeee-news-slider class="section-teeeee__news-slider-wrapper">
          <div class="swiper" id="swiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {% for article in blog.articles limit: section.settings.news_limit %}
                <div class="swiper-slide section-teeeee__news-card">
                  <a href="{{ article.url }}" class="section-teeeee__news-card-link">
                    {% if article.image != blank %}
                      {{ article.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'section-teeeee__news-card-image', alt: article.image.alt | default: article.title }}
                    {% else %}
                      <div class="section-teeeee__news-card-image-placeholder">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {% endif %}
                    <div class="section-teeeee__news-card-content">
                      <span class="section-teeeee__news-card-date">{{ article.published_at | time_tag: format: 'date' }}</span>
                      <h3 class="section-teeeee__news-card-title">{{ article.title }}</h3>
                      <span class="section-teeeee__news-card-read-more">
                        {{ 'sections.teeeee.news.read_more' | t }}
                        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" viewBox="0 0 10 10">
                          <path d="M2.375 1.25L6.125 5L2.375 8.75" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="swiper-button-prev">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" viewBox="0 0 10 10">
              <path d="M2.375 1.25L6.125 5L2.375 8.75" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="swiper-button-next">
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" viewBox="0 0 10 10">
              <path d="M2.375 1.25L6.125 5L2.375 8.75" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </teeeee-news-slider>
      {% else %}
        <div class="section-teeeee__news-empty">
          <p>{{ 'sections.teeeee.news.no_articles' | t }}</p>
          {% if shop.blogs.size == 0 %}
            <p>{{ 'sections.teeeee.news.no_blogs_info' | t }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.news_view_all_text != blank and section.settings.news_view_all_link != blank %}
        <div class="section-teeeee__news-view-all-mobile hidden-desktop">
          <a href="{{ section.settings.news_view_all_link }}" class="button button--tertiary">
            {{ section.settings.news_view_all_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </section>

  {# Services & Offerings Section #}
  <section class="section-teeeee__services color-{{ section.settings.services_color_scheme }} gradient">
    <div class="page-width">
      {% if section.settings.services_heading != blank %}
        <h2 class="section-teeeee__services-heading">{{ section.settings.services_heading }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="section-teeeee__services-grid">
          {% for block in section.blocks %}
            <div class="section-teeeee__service-card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'section-teeeee__service-card-image', alt: block.settings.image.alt | default: block.settings.title }}
              {% else %}
                <div class="section-teeeee__service-card-image-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
              <div class="section-teeeee__service-card-content">
                {% if block.settings.title != blank %}
                  <h3 class="section-teeeee__service-card-title">{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class="section-teeeee__service-card-description rte">
                    {{ block.settings.description }}
                  </div>
                {% endif %}
                {% if block.settings.button_text != blank and block.settings.button_link != blank %}
                  <a href="{{ block.settings.button_link }}" class="button button--link">
                    {{ block.settings.button_text }}
                    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-arrow" viewBox="0 0 10 10">
                      <path d="M2.375 1.25L6.125 5L2.375 8.75" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="section-teeeee__services-empty">
          <p>{{ 'sections.teeeee.services.no_blocks' | t }}</p>
        </div>
      {% endif %}
    </div>
  </section>

  {# Video Section #}
  <section class="section-teeeee__video color-{{ section.settings.video_color_scheme }} gradient">
    <div class="section-teeeee__video-background">
      {% if section.settings.video_background_image != blank %}
        {{ section.settings.video_background_image | image_url: width: 1920 | image_tag: loading: 'lazy', class: 'section-teeeee__video-image', alt: section.settings.video_background_image.alt | default: section.settings.video_heading | strip_html }}
      {% else %}
        <div class="section-teeeee__video-placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
      <div class="section-teeeee__video-overlay"></div>
    </div>
    <div class="section-teeeee__video-content page-width">
      {% if section.settings.video_heading != blank %}
        <h2 class="section-teeeee__video-heading">{{ section.settings.video_heading }}</h2>
      {% endif %}
      {% if section.settings.video_url != blank %}
        <a href="{{ section.settings.video_url }}" class="button button--play" aria-label="{{ 'sections.teeeee.video.play_video_label' | t }}">
          <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-play" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 5V19L19 12L8 5Z" fill="currentColor"/>
          </svg>
          {% if section.settings.video_button_text != blank %}
            <span>{{ section.settings.video_button_text }}</span>
          {% endif %}
        </a>
      {% endif %}
    </div>
  </section>

  {# Contact Call to Action Section #}
  <section class="section-teeeee__contact color-{{ section.settings.contact_color_scheme }} gradient">
    <div class="page-width section-teeeee__contact-wrapper">
      {% if section.settings.contact_heading != blank %}
        <h2 class="section-teeeee__contact-heading">{{ section.settings.contact_heading }}</h2>
      {% endif %}
      {% if section.settings.contact_button_text != blank and section.settings.contact_button_link != blank %}
        <a href="{{ section.settings.contact_button_link }}" class="button button--primary">
          {{ section.settings.contact_button_text }}
        </a>
      {% endif %}
    </div>
  </section>
</div>

