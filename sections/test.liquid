<!-- Main Section Wrapper -->
<div class="qqqq" id="qqqq-{{ section.id }}" data-controller="qqqq-hero">

  <!-- ============================================================
       NAVIGATION HEADER (inline)
       ============================================================ -->
  <header class="qqqq__nav" role="banner">
    <div class="qqqq__nav-inner">

      <!-- Logo -->
      <a href="{{ shop.url }}" class="qqqq__nav-logo" aria-label="{{ section.settings.logo_text }} {{ section.settings.logo_subtext }}">
        <span class="qqqq__nav-logo-icon" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="1" y="1" width="34" height="34" rx="2" stroke="#FFFFFF" stroke-width="1.5"/>
            <circle cx="18" cy="18" r="5" fill="#7B2FBE"/>
            <circle cx="18" cy="18" r="2" fill="#FFFFFF"/>
            <line x1="4" y1="18" x2="12" y2="18" stroke="#FFFFFF" stroke-width="1.5"/>
            <line x1="24" y1="18" x2="32" y2="18" stroke="#FFFFFF" stroke-width="1.5"/>
          </svg>
        </span>
        <span class="qqqq__nav-logo-text">
          <span class="qqqq__nav-logo-brand">{{ section.settings.logo_text }}</span>
          <span class="qqqq__nav-logo-sub">{{ section.settings.logo_subtext }}</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="qqqq__nav-links hidden-mobile" aria-label="{{ 'sections.qqqq.nav_aria_label' | t }}">
        <ul class="qqqq__nav-list" role="list">
          {%- if section.settings.nav_link_1_label != blank -%}
            <li class="qqqq__nav-item qqqq__nav-item--active">
              <a href="{{ section.settings.nav_link_1_url }}" class="qqqq__nav-link">{{ section.settings.nav_link_1_label }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.nav_link_2_label != blank -%}
            <li class="qqqq__nav-item">
              <a href="{{ section.settings.nav_link_2_url }}" class="qqqq__nav-link">{{ section.settings.nav_link_2_label }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.nav_link_3_label != blank -%}
            <li class="qqqq__nav-item">
              <a href="{{ section.settings.nav_link_3_url }}" class="qqqq__nav-link">{{ section.settings.nav_link_3_label }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.nav_link_4_label != blank -%}
            <li class="qqqq__nav-item">
              <a href="{{ section.settings.nav_link_4_url }}" class="qqqq__nav-link">{{ section.settings.nav_link_4_label }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.nav_link_5_label != blank -%}
            <li class="qqqq__nav-item">
              <a href="{{ section.settings.nav_link_5_url }}" class="qqqq__nav-link">{{ section.settings.nav_link_5_label }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.nav_link_6_label != blank -%}
            <li class="qqqq__nav-item">
              <a href="{{ section.settings.nav_link_6_url }}" class="qqqq__nav-link">{{ section.settings.nav_link_6_label }}</a>
            </li>
          {%- endif -%}
        </ul>
      </nav>

      <!-- Nav CTA Button (desktop) -->
      {%- unless section.settings.nav_cta_label == blank -%}
        <a href="{{ section.settings.nav_cta_url }}"
           class="qqqq__nav-cta hidden-mobile"
           aria-label="{{ section.settings.nav_cta_label }}">
          {{ section.settings.nav_cta_label }}
        </a>
      {%- endunless -%}

      <!-- Mobile Hamburger -->
      <button type="button"
              class="qqqq__nav-hamburger hidden-desktop"
              aria-label="{{ 'sections.qqqq.mobile_menu_label' | t }}"
              aria-expanded="false"
              aria-controls="qqqq-mobile-menu-{{ section.id }}"
              data-action="click->qqqq-hero#toggleMobileMenu">
        <span class="qqqq__hamburger-line"></span>
        <span class="qqqq__hamburger-line"></span>
        <span class="qqqq__hamburger-line"></span>
      </button>

    </div>

    <!-- Mobile Menu Drawer -->
    <div class="qqqq__mobile-menu hidden-desktop"
         id="qqqq-mobile-menu-{{ section.id }}"
         aria-hidden="true">
      <nav aria-label="{{ 'sections.qqqq.mobile_nav_aria_label' | t }}">
        <ul class="qqqq__mobile-nav-list" role="list">
          {%- if section.settings.nav_link_1_label != blank -%}
            <li><a href="{{ section.settings.nav_link_1_url }}" class="qqqq__mobile-nav-link">{{ section.settings.nav_link_1_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_2_label != blank -%}
            <li><a href="{{ section.settings.nav_link_2_url }}" class="qqqq__mobile-nav-link">{{ section.settings.nav_link_2_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_3_label != blank -%}
            <li><a href="{{ section.settings.nav_link_3_url }}" class="qqqq__mobile-nav-link">{{ section.settings.nav_link_3_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_4_label != blank -%}
            <li><a href="{{ section.settings.nav_link_4_url }}" class="qqqq__mobile-nav-link">{{ section.settings.nav_link_4_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_5_label != blank -%}
            <li><a href="{{ section.settings.nav_link_5_url }}" class="qqqq__mobile-nav-link">{{ section.settings.nav_link_5_label }}</a></li>
          {%- endif -%}
          {%- if section.settings.nav_link_6_label != blank -%}
            <li><a href="{{ section.settings.nav_link_6_url }}" class="qqqq__mobile-nav-link">{{ section.settings.nav_link_6_label }}</a></li>
          {%- endif -%}
          {%- unless section.settings.nav_cta_label == blank -%}
            <li>
              <a href="{{ section.settings.nav_cta_url }}" class="qqqq__btn qqqq__btn--primary qqqq__mobile-cta">
                {{ section.settings.nav_cta_label }}
              </a>
            </li>
          {%- endunless -%}
        </ul>
      </nav>
    </div>
  </header>

  <!-- ============================================================
       HERO SECTION
       ============================================================ -->
  <section class="qqqq__hero" aria-label="{{ 'sections.qqqq.hero_aria_label' | t }}">

    <!-- Dot Grid Background -->
    <div class="qqqq__dot-grid" aria-hidden="true"></div>

    <!-- Purple Glow Background -->
    <div class="qqqq__bg-glow" aria-hidden="true"></div>

    <div class="qqqq__hero-inner">

      <!-- ── LEFT CONTENT COLUMN ────────────────────────────── -->
      <div class="qqqq__hero-content">

        <!-- Service Tags Badge (inline) -->
        {%- unless section.settings.badge_text == blank -%}
          <div class="qqqq__badge" aria-label="{{ section.settings.badge_text }}">
            <span class="qqqq__badge-dot" aria-hidden="true"></span>
            <span class="qqqq__badge-text">{{ section.settings.badge_text }}</span>
          </div>
        {%- endunless -%}

        <!-- Hero Headline -->
        <h1 class="qqqq__headline">
          {%- unless section.settings.headline_line1 == blank -%}
            <span class="qqqq__headline-white">{{ section.settings.headline_line1 }}</span>
          {%- endunless -%}
          {%- unless section.settings.headline_line2 == blank -%}
            <span class="qqqq__headline-purple">{{ section.settings.headline_line2 }}</span>
          {%- endunless -%}
          {%- unless section.settings.headline_line3 == blank -%}
            <span class="qqqq__headline-white">{{ section.settings.headline_line3 }}</span>
          {%- endunless -%}
        </h1>

        <!-- Hero Subheadline -->
        {%- unless section.settings.subheadline == blank -%}
          <p class="qqqq__subheadline">{{ section.settings.subheadline }}</p>
        {%- endunless -%}

        <!-- CTA Buttons -->
        <div class="qqqq__cta-group">
          {%- unless section.settings.primary_cta_label == blank -%}
            <a href="{{ section.settings.primary_cta_url }}"
               class="qqqq__btn qqqq__btn--primary"
               aria-label="{{ section.settings.primary_cta_label }}">
              {{ section.settings.primary_cta_label }}
            </a>
          {%- endunless -%}
          {%- unless section.settings.secondary_cta_label == blank -%}
            <a href="{{ section.settings.secondary_cta_url }}"
               class="qqqq__btn qqqq__btn--secondary"
               aria-label="{{ section.settings.secondary_cta_label }}">
              {{ section.settings.secondary_cta_label }} →
            </a>
          {%- endunless -%}
        </div>

        <!-- Stats Bar (inline) -->
        <div class="qqqq__stats" role="list" aria-label="{{ 'sections.qqqq.stats_aria_label' | t }}">
          {%- unless section.settings.stat1_value == blank -%}
            <div class="qqqq__stat" role="listitem">
              <span class="qqqq__stat-value">{{ section.settings.stat1_value }}</span>
              <span class="qqqq__stat-label">{{ section.settings.stat1_label }}</span>
            </div>
          {%- endunless -%}
          {%- unless section.settings.stat2_value == blank -%}
            <div class="qqqq__stat" role="listitem">
              <span class="qqqq__stat-value">{{ section.settings.stat2_value }}</span>
              <span class="qqqq__stat-label">{{ section.settings.stat2_label }}</span>
            </div>
          {%- endunless -%}
          {%- unless section.settings.stat3_value == blank -%}
            <div class="qqqq__stat" role="listitem">
              <span class="qqqq__stat-value">{{ section.settings.stat3_value }}</span>
              <span class="qqqq__stat-label">{{ section.settings.stat3_label }}</span>
            </div>
          {%- endunless -%}
          {%- unless section.settings.stat4_value == blank -%}
            <div class="qqqq__stat" role="listitem">
              <span class="qqqq__stat-value">{{ section.settings.stat4_value }}</span>
              <span class="qqqq__stat-label">{{ section.settings.stat4_label }}</span>
            </div>
          {%- endunless -%}
        </div>

      </div>
      <!-- /LEFT CONTENT COLUMN -->

      <!-- ── RIGHT DECORATIVE COLUMN — Radar Graphic (inline) ── -->
      <div class="qqqq__hero-graphic" aria-hidden="true">
        <div class="qqqq__radar-wrapper">

          <!-- Radial glow behind radar -->
          <div class="qqqq__radar-glow"></div>

          <!-- SVG Radar / Crosshair Graphic -->
          <svg class="qqqq__radar-svg" viewBox="0 0 700 700" fill="none" xmlns="http://www.w3.org/2000/svg">

            <!-- Concentric circles -->
            <circle cx="350" cy="350" r="330" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
            <circle cx="350" cy="350" r="270" stroke="rgba(255,255,255,0.07)" stroke-width="1"/>
            <circle cx="350" cy="350" r="210" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
            <circle cx="350" cy="350" r="150" stroke="rgba(255,255,255,0.09)" stroke-width="1"/>
            <circle cx="350" cy="350" r="90"  stroke="rgba(255,255,255,0.10)" stroke-width="1"/>
            <circle cx="350" cy="350" r="40"  stroke="rgba(255,255,255,0.12)" stroke-width="1"/>

            <!-- Cross lines -->
            <line x1="20"  y1="350" x2="680" y2="350" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
            <line x1="350" y1="20"  x2="350" y2="680" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>

            <!-- Diagonal lines -->
            <line x1="116" y1="116" x2="584" y2="584" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
            <line x1="584" y1="116" x2="116" y2="584" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>

            <!-- Center glow orb -->
            <circle cx="350" cy="350" r="60" fill="url(#qqqq-centerGlow-{{ section.id }})"/>

            <!-- Bracket logo at center -->
            <g transform="translate(306,312)">
              <rect x="2" y="2" width="84" height="72" rx="3" stroke="rgba(255,255,255,0.9)" stroke-width="2" fill="none"/>
              <circle cx="44" cy="38" r="14" stroke="rgba(255,255,255,0.9)" stroke-width="2" fill="none"/>
              <circle cx="44" cy="38" r="5" fill="#7B2FBE"/>
            </g>

            <!-- Tick marks on outer circle -->
            <line x1="350" y1="20"  x2="350" y2="38"  stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
            <line x1="350" y1="662" x2="350" y2="680" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
            <line x1="20"  y1="350" x2="38"  y2="350" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
            <line x1="662" y1="350" x2="680" y2="350" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>

            <!-- Small dot markers on circles -->
            <circle cx="350" cy="80"  r="3" fill="rgba(123,47,190,0.7)"/>
            <circle cx="350" cy="620" r="3" fill="rgba(123,47,190,0.7)"/>
            <circle cx="80"  cy="350" r="3" fill="rgba(123,47,190,0.7)"/>
            <circle cx="620" cy="350" r="3" fill="rgba(123,47,190,0.7)"/>

            <defs>
              <radialGradient id="qqqq-centerGlow-{{ section.id }}" cx="50%" cy="50%" r="50%">
                <stop offset="0%"   stop-color="#7B2FBE" stop-opacity="0.55"/>
                <stop offset="55%"  stop-color="#7B2FBE" stop-opacity="0.18"/>
                <stop offset="100%" stop-color="#7B2FBE" stop-opacity="0"/>
              </radialGradient>
            </defs>

          </svg>
        </div>
      </div>
      <!-- /RIGHT DECORATIVE COLUMN -->

    </div>
    <!-- /hero-inner -->

    <!-- Bottom Bar: Slide Counter + Scroll Indicator -->
    <div class="qqqq__bottom-bar">
      {%- unless section.settings.slide_counter == blank -%}
        <span class="qqqq__slide-counter" aria-hidden="true">{{ section.settings.slide_counter }}</span>
      {%- endunless -%}
      <span class="qqqq__scroll-indicator" aria-hidden="true">{{ 'sections.qqqq.scroll_label' | t }} →</span>
    </div>

  </section>
  <!-- /HERO SECTION -->

</div>
<!-- /qqqq -->

