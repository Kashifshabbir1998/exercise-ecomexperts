      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="site-header__nav hidden-mobile" role="navigation" aria-label="{{ 'sections.llll.nav_aria' | t }}">
      <ul class="site-header__nav-list" role="list">
        <li class="site-header__nav-item">
          <a href="{{ section.settings.nav_link1_url }}" class="site-header__nav-link site-header__nav-link--active" aria-current="page">{{ section.settings.nav_link1_label }}</a>
        </li>
        <li class="site-header__nav-item">
          <a href="{{ section.settings.nav_link2_url }}" class="site-header__nav-link">{{ section.settings.nav_link2_label }}</a>
        </li>
        <li class="site-header__nav-item">
          <a href="{{ section.settings.nav_link3_url }}" class="site-header__nav-link">{{ section.settings.nav_link3_label }}</a>
        </li>
        <li class="site-header__nav-item">
          <a href="{{ section.settings.nav_link4_url }}" class="site-header__nav-link">{{ section.settings.nav_link4_label }}</a>
        </li>
        <li class="site-header__nav-item">
          <a href="{{ section.settings.nav_link5_url }}" class="site-header__nav-link">{{ section.settings.nav_link5_label }}</a>
        </li>
        <li class="site-header__nav-item">
          <a href="{{ section.settings.nav_link6_url }}" class="site-header__nav-link">{{ section.settings.nav_link6_label }}</a>
        </li>
      </ul>
    </nav>

    <!-- Decorative floating cursor dot (desktop only) -->
    <div class="site-header__float-dot hidden-mobile" aria-hidden="true"></div>

    <!-- Desktop CTA -->
    {% unless section.settings.nav_cta_label == blank %}
    <a href="{{ section.settings.nav_cta_url }}"
       class="site-header__cta hidden-mobile"
       aria-label="{{ section.settings.nav_cta_label }}">
      {{ section.settings.nav_cta_label }}
    </a>
    {% endunless %}

    <!-- Mobile hamburger -->
    <button type="button"
            class="site-header__hamburger hidden-desktop"
            aria-label="{{ 'sections.llll.menu_open' | t }}"
            aria-expanded="false"
            aria-controls="mobile-nav-{{ section.id }}">
      <span class="site-header__hamburger-bar"></span>
      <span class="site-header__hamburger-bar"></span>
      <span class="site-header__hamburger-bar"></span>
    </button>

  </div>

  <!-- Mobile Navigation Drawer -->
  <nav class="site-header__mobile-nav hidden-desktop"
       id="mobile-nav-{{ section.id }}"
       role="navigation"
       aria-label="{{ 'sections.llll.mobile_nav_aria' | t }}"
       aria-hidden="true">
    <ul class="site-header__mobile-nav-list" role="list">
      <li><a href="{{ section.settings.nav_link1_url }}" class="site-header__mobile-nav-link">{{ section.settings.nav_link1_label }}</a></li>
      <li><a href="{{ section.settings.nav_link2_url }}" class="site-header__mobile-nav-link">{{ section.settings.nav_link2_label }}</a></li>
      <li><a href="{{ section.settings.nav_link3_url }}" class="site-header__mobile-nav-link">{{ section.settings.nav_link3_label }}</a></li>
      <li><a href="{{ section.settings.nav_link4_url }}" class="site-header__mobile-nav-link">{{ section.settings.nav_link4_label }}</a></li>
      <li><a href="{{ section.settings.nav_link5_url }}" class="site-header__mobile-nav-link">{{ section.settings.nav_link5_label }}</a></li>
      <li><a href="{{ section.settings.nav_link6_url }}" class="site-header__mobile-nav-link">{{ section.settings.nav_link6_label }}</a></li>
      {% unless section.settings.nav_cta_label == blank %}
      <li>
        <a href="{{ section.settings.nav_cta_url }}" class="site-header__mobile-nav-cta">{{ section.settings.nav_cta_label }}</a>
      </li>
      {% endunless %}
    </ul>
  </nav>
</header>

<!-- Main Page Wrapper -->
<main class="llll-page" id="llll-{{ section.id }}">

  <!-- Hero Section -->
  <section class="hero" id="hero-{{ section.id }}" aria-label="{{ section.settings.hero_aria_label }}">

    <!-- Background dot grid texture -->
    <div class="hero__bg-grid" aria-hidden="true"></div>

    <!-- Radial purple glow overlay -->
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="hero__inner">

      <!-- Left: Content Column -->
      <div class="hero__content">

        <!-- Hero Badge — inline -->
        {% unless section.settings.badge_text == blank %}
        <div class="hero-badge" aria-label="{{ section.settings.badge_text }}">
          <span class="hero-badge__dot" aria-hidden="true"></span>
          <span class="hero-badge__text">{{ section.settings.badge_text }}</span>
        </div>
        {% endunless %}

        <!-- Headline -->
        <h1 class="hero__headline">
          <span class="hero__headline--white">{{ section.settings.headline_line1 }}</span><br>
          <span class="hero__headline--purple">{{ section.settings.headline_line2 }}</span><br>
          <span class="hero__headline--white">{{ section.settings.headline_line3 }}</span>
        </h1>

        <!-- Body text -->
        {% unless section.settings.hero_body == blank %}
        <p class="hero__body">{{ section.settings.hero_body }}</p>
        {% endunless %}

        <!-- CTA Buttons -->
        <div class="hero__ctas">
          {% unless section.settings.cta_primary_label == blank %}
          <a href="{{ section.settings.cta_primary_url }}"
             class="hero__cta hero__cta--primary"
             aria-label="{{ section.settings.cta_primary_label }}">
            {{ section.settings.cta_primary_label }}
          </a>
          {% endunless %}
          {% unless section.settings.cta_secondary_label == blank %}
          <a href="{{ section.settings.cta_secondary_url }}"
             class="hero__cta hero__cta--secondary"
             aria-label="{{ section.settings.cta_secondary_label }}">
            {{ section.settings.cta_secondary_label }} →
          </a>
          {% endunless %}
        </div>

        <!-- Stats Bar — inline -->
        <div class="stats-bar" role="region" aria-label="{{ 'sections.llll.stats_aria' | t }}">
          {% unless section.settings.stat1_value == blank %}
          <div class="stats-bar__item">
            <span class="stats-bar__value">{{ section.settings.stat1_value }}</span>
            <span class="stats-bar__label">{{ section.settings.stat1_label }}</span>
          </div>
          {% endunless %}
          {% unless section.settings.stat2_value == blank %}
          <div class="stats-bar__item">
            <span class="stats-bar__value">{{ section.settings.stat2_value }}</span>
            <span class="stats-bar__label">{{ section.settings.stat2_label }}</span>
          </div>
          {% endunless %}
          {% unless section.settings.stat3_value == blank %}
          <div class="stats-bar__item">
            <span class="stats-bar__value">{{ section.settings.stat3_value }}</span>
            <span class="stats-bar__label">{{ section.settings.stat3_label }}</span>
          </div>
          {% endunless %}
          {% unless section.settings.stat4_value == blank %}
          <div class="stats-bar__item">
            <span class="stats-bar__value">{{ section.settings.stat4_value }}</span>
            <span class="stats-bar__label">{{ section.settings.stat4_label }}</span>
          </div>
          {% endunless %}
        </div>

      </div>
      <!-- /hero__content -->

      <!-- Right: Decorative Circular Graphic -->
      <div class="hero__decoration" aria-hidden="true">
        <div class="hero__circle hero__circle--outer"></div>
        <div class="hero__circle hero__circle--mid"></div>
        <div class="hero__circle hero__circle--inner"></div>
        <div class="hero__crosshair hero__crosshair--h"></div>
        <div class="hero__crosshair hero__crosshair--v"></div>
        <div class="hero__center-glow"></div>
        <!-- Bracket-dot logo mark -->
        <div class="hero__logo-mark">
          <span class="hero__logo-bracket hero__logo-bracket--left">[</span>
          <span class="hero__logo-dot-wrap">
            <span class="hero__logo-dot"></span>
          </span>
          <span class="hero__logo-bracket hero__logo-bracket--right">]</span>
        </div>
      </div>
      <!-- /hero__decoration -->

    </div>
    <!-- /hero__inner -->

    <!-- Slide Counter -->
    <div class="hero__slide-counter" aria-label="{{ 'sections.llll.slide_counter_aria' | t }}">
      <span class="hero__slide-current">01</span>
      <span class="hero__slide-sep"> / </span>
      <span class="hero__slide-total">07</span>
    </div>

    <!-- Scroll Indicator -->
    <div class="hero__scroll-indicator" aria-label="{{ 'sections.llll.scroll_label' | t }}">
      <span>{{ 'sections.llll.scroll_text' | t }}</span>
      <span class="hero__scroll-arrow">→</span>
    </div>

  </section>
  <!-- /Hero Section -->

</main>

