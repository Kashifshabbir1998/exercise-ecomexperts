{% comment %} <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script> {% endcomment %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js" integrity="sha512-Ysw1DcK1P+uYLqprEAzNQJP+J4hTx4t/3X2nbVwszao8wD+9afLjBQYjz7Uk4ADP+Er++mJoScI42ueGtQOzEA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script defer="defer">
  class TeeeeNewsSlider extends HTMLElement {
    constructor() {
      super();
      this.slider = this.querySelector('.swiper');
      this.nextButton = this.querySelector('.swiper-button-next');
      this.prevButton = this.querySelector('.swiper-button-prev');
      this.initSlider();
    }

    initSlider() {
      if (!this.slider) return;

      const swiper = new Swiper(this.slider, {
        loop: true,
        autoplay: false,
        slidesPerView: 1.2, // Mobile default
        spaceBetween: 20,
        navigation: {
          nextEl: this.nextButton,
          prevEl: this.prevButton,
        },
        breakpoints: {
          750: { // Desktop breakpoint
            slidesPerView: 3,
            spaceBetween: 30,
          }
        }
      });
    }
  }

  customElements.define('teeeee-news-slider', TeeeeNewsSlider);
</script>