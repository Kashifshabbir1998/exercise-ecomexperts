{% comment %}
  custom-miracle-balm.liquid
  Purpose: A highly converting custom responsive section matching the "10 reasons" design.
  Compatible with Shopify 2.0 (Dawn Theme).
{% endcomment %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap');

  #shopify-section-{{ section.id }} {
      --color-black: {{ section.settings.color_black | default: '#000000' }};
      --color-white: {{ section.settings.color_white | default: '#ffffff' }};
      --color-pink: {{ section.settings.color_pink | default: '#eb2663' }};
      --color-text-body: {{ section.settings.color_text_body | default: '#4a4a4a' }};
      --color-text-light: {{ section.settings.color_text_light | default: '#767676' }};
      --color-number: {{ section.settings.color_number | default: '#ebebeb' }};
      --color-image-bg: {{ section.settings.color_image_bg | default: '#f4f4f4' }};
      --color-border: {{ section.settings.color_border | default: '#f0f0f0' }};

      --font-serif: 'Playfair Display', serif;
      --font-sans: 'Inter', sans-serif;

      --spacing-xs: 8px;
      --spacing-sm: 16px;
      --spacing-md: 24px;
      --spacing-lg: 40px;
      --spacing-xl: 80px;
      --spacing-xxl: 120px;

      --container-max-width: 960px;
  }

  /* Media Queries for Root Variables */
  @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} {
          --spacing-xxl: 80px;
          --spacing-xl: 50px;
      }
  }

  .miracle-balm-wrapper {
      font-family: var(--font-sans);
      color: var(--color-text-body);
      line-height: 1.6;
      background-color: var(--color-white);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow: hidden;
  }

  .miracle-balm-wrapper img {
      max-width: 100%;
      height: auto;
      display: block;
  }

  .miracle-balm-wrapper a {
      text-decoration: none;
      color: inherit;
  }

  /* Typography */
  .miracle-balm-wrapper h1,
  .miracle-balm-wrapper h2,
  .miracle-balm-wrapper h3,
  .miracle-balm-wrapper h4,
  .miracle-balm-wrapper .serif-text {
      font-family: var(--font-serif);
      color: var(--color-black);
      font-weight: 400;
      margin-top: 0;
  }

  .miracle-balm-wrapper .eyebrow {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--color-pink);
      font-weight: 600;
      margin-bottom: var(--spacing-sm);
      display: block;
  }

  .miracle-balm-wrapper .heading-1 {
      font-size: 42px;
      line-height: 1.2;
      margin-bottom: var(--spacing-md);
  }

  .miracle-balm-wrapper .heading-2 {
      font-size: 28px;
      line-height: 1.3;
      margin-bottom: var(--spacing-sm);
  }

  .miracle-balm-wrapper .body-large {
      font-size: 18px;
      line-height: 1.6;
      color: var(--color-text-light);
  }

  .miracle-balm-wrapper .body-large p {
      margin: 0;
  }

  .miracle-balm-wrapper .body-regular,
  .miracle-balm-wrapper .body-regular p {
      font-size: 15px;
      line-height: 1.7;
      margin-bottom: 0;
  }

  .miracle-balm-wrapper .body-regular strong,
  .miracle-balm-wrapper .body-regular b {
      font-weight: 600;
      color: var(--color-black);
  }

  /* Layout */
  .miracle-balm-wrapper .container {
      max-width: var(--container-max-width);
      margin: 0 auto;
      padding: 0 var(--spacing-md);
  }

  /* Buttons Component */
  .miracle-balm-wrapper .btn {
      display: inline-block;
      background-color: var(--color-black);
      color: var(--color-white);
      padding: 16px 40px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      border: 1px solid var(--color-black);
      transition: background-color 0.3s ease, color 0.3s ease;
      cursor: pointer;
  }

  .miracle-balm-wrapper .btn:hover {
      background-color: transparent;
      color: var(--color-black);
  }

  .miracle-balm-wrapper .btn--white {
      background-color: var(--color-white);
      color: var(--color-black);
      border-color: var(--color-white);
  }

  .miracle-balm-wrapper .btn--white:hover {
      background-color: transparent;
      color: var(--color-white);
  }

  /* Stars Component */
  .miracle-balm-wrapper .stars-container {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: var(--spacing-lg);
      font-size: 14px;
      color: var(--color-text-light);
  }

  .miracle-balm-wrapper .stars {
      color: var(--color-black);
      font-size: 16px;
      letter-spacing: 2px;
  }

  /* Hero Section */
  .miracle-balm-wrapper .hero-section {
      text-align: center;
      padding: var(--spacing-xxl) 0;
      border-bottom: 1px solid var(--color-border);
  }

  .miracle-balm-wrapper .hero-section .heading-1 {
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
  }

  .miracle-balm-wrapper .hero-section .body-large {
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: var(--spacing-md);
  }

  /* Feature Row Section */
  .miracle-balm-wrapper .feature-list {
      padding: var(--spacing-lg) 0;
  }

  .miracle-balm-wrapper .feature-row {
      display: flex;
      align-items: center;
      padding: var(--spacing-xl) 0;
      border-bottom: 1px solid var(--color-border);
      gap: 60px;
  }

  .miracle-balm-wrapper .feature-list .feature-row:last-child {
      border-bottom: none;
  }

  .miracle-balm-wrapper .feature-image-wrapper {
      flex: 1;
      background-color: var(--color-image-bg);
      padding: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 480px;
  }

  .miracle-balm-wrapper .feature-image-wrapper img {
      width: 100%;
      max-width: 320px;
      object-fit: contain;
      filter: drop-shadow(0px 30px 40px rgba(0, 0, 0, 0.1));
  }

  .miracle-balm-wrapper .feature-image-wrapper svg.placeholder-svg {
      width: 100%;
      height: 100%;
      max-width: 320px;
      fill: #ccc;
  }

  .miracle-balm-wrapper .feature-text-wrapper {
      flex: 1;
      padding-right: 40px;
  }

  .miracle-balm-wrapper .feature-number {
      font-family: var(--font-serif);
      font-size: 80px;
      color: var(--color-number);
      line-height: 1;
      letter-spacing: -2px;
  }

  /* Testimonial Section */
  .miracle-balm-wrapper .testimonial-section {
      padding: var(--spacing-xl) 0;
      text-align: center;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
  }

  .miracle-balm-wrapper .testimonial-quote {
      max-width: 700px;
      margin: 0 auto;
  }

  .miracle-balm-wrapper .testimonial-quote .stars {
      margin-bottom: var(--spacing-md);
      display: block;
  }

  .miracle-balm-wrapper .testimonial-quote blockquote {
      font-family: var(--font-serif);
      font-size: 26px;
      line-height: 1.4;
      color: var(--color-black);
      font-style: italic;
      margin: 0 0 var(--spacing-md) 0;
  }

  .miracle-balm-wrapper .testimonial-author {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--color-text-light);
  }

  /* Mid CTA Banner */
  .miracle-balm-wrapper .mid-cta-banner {
      background-color: var(--color-black);
      color: var(--color-white);
      text-align: center;
      padding: var(--spacing-xl) 20px;
  }

  .miracle-balm-wrapper .mid-cta-banner h2 {
      color: var(--color-white);
      font-size: 32px;
      margin-bottom: var(--spacing-xs);
  }

  .miracle-balm-wrapper .mid-cta-banner p {
      color: #aaaaaa;
      margin: 0 0 var(--spacing-lg) 0;
      font-size: 15px;
  }

  /* Bottom CTA Section */
  .miracle-balm-wrapper .bottom-cta-section {
      text-align: center;
      padding: var(--spacing-xxl) 0;
  }

  .miracle-balm-wrapper .bottom-cta-section .heading-1 {
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
  }

  .miracle-balm-wrapper .bottom-cta-section .body-regular {
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: var(--spacing-lg);
      color: var(--color-text-light);
  }

  .miracle-balm-wrapper .benefits-row {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: var(--spacing-lg);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--color-text-light);
      flex-wrap: wrap;
  }

  /* Media Queries */
  @media screen and (max-width: 768px) {
      .miracle-balm-wrapper .heading-1 {
          font-size: 32px;
      }

      .miracle-balm-wrapper .heading-2 {
          font-size: 24px;
      }

      .miracle-balm-wrapper .body-large {
          font-size: 16px;
      }

      .miracle-balm-wrapper .feature-row {
          flex-direction: column;
          gap: var(--spacing-lg);
          padding: var(--spacing-lg) 0;
      }

      .miracle-balm-wrapper .feature-image-wrapper {
          width: 100%;
          min-height: 340px;
          padding: 30px;
      }

      .miracle-balm-wrapper .feature-text-wrapper {
          padding-right: 0;
          width: 100%;
      }

      .miracle-balm-wrapper .feature-number {
          font-size: 64px;
          margin-bottom: -10px;
      }

      .miracle-balm-wrapper .testimonial-quote blockquote {
          font-size: 22px;
      }

      .miracle-balm-wrapper .mid-cta-banner h2 {
          font-size: 26px;
      }

      .miracle-balm-wrapper .benefits-row {
          gap: 16px;
      }
  }
{% endstyle %}

<div class="miracle-balm-wrapper">
  {% for block in section.blocks %}
    {%- case block.type -%}
      {%- when 'hero' -%}
        <section class="hero-section" {{ block.shopify_attributes }}>
          <div class="container">
            {% if block.settings.eyebrow != blank %}
              <span class="eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h1 class="heading-1">{{ block.settings.heading | escape }}</h1>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="body-large">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.show_reviews %}
              <div class="stars-container">
                <span class="stars">★★★★★</span>
                <span>{{ block.settings.reviews_text | escape }}</span>
              </div>
            {% endif %}

            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link | default: '#' }}" class="btn">
                {{- block.settings.button_label | escape -}}
              </a>
            {% endif %}
          </div>
        </section>

      {%- when 'feature' -%}
        {% assign is_first_feature = false %}
        {% assign is_last_feature = false %}

        {% if forloop.first %}
          {% assign is_first_feature = true %}
        {% else %}
          {% assign prev_index = forloop.index0 | minus: 1 %}
          {% if section.blocks[prev_index].type != 'feature' %}
            {% assign is_first_feature = true %}
          {% endif %}
        {% endif %}

        {% if forloop.last %}
          {% assign is_last_feature = true %}
        {% else %}
          {% assign next_index = forloop.index0 | plus: 1 %}
          {% if section.blocks[next_index].type != 'feature' %}
            {% assign is_last_feature = true %}
          {% endif %}
        {% endif %}

        {% if is_first_feature %}
          <section class="feature-list">
            <div class="container">
        {% endif %}

        <div class="feature-row" {{ block.shopify_attributes }}>
          <div class="feature-image-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 640
                | image_tag: loading: 'lazy', alt: block.settings.image.alt
                | escape
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="feature-text-wrapper">
            {% if block.settings.number != blank %}
              <div class="feature-number">{{ block.settings.number | escape }}</div>
            {% endif %}
            <h2 class="heading-2">{{ block.settings.heading | escape }}</h2>
            <div class="body-regular">{{ block.settings.text }}</div>
          </div>
        </div>

        {% if is_last_feature %}
          </div>
          </section>
        {% endif %}

      {%- when 'testimonial' -%}
        <section class="testimonial-section" {{ block.shopify_attributes }}>
          <div class="container">
            <div class="testimonial-quote">
              <span class="stars">★★★★★</span>
              <blockquote>"{{ block.settings.quote | escape }}"</blockquote>
              {% if block.settings.author != blank %}
                <div class="testimonial-author">— {{ block.settings.author | escape }}</div>
              {% endif %}
            </div>
          </div>
        </section>

      {%- when 'mid_cta' -%}
        <section class="mid-cta-banner" {{ block.shopify_attributes }}>
          <div class="container">
            <h2>{{ block.settings.heading | escape }}</h2>
            <p>{{ block.settings.text | escape }}</p>
            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link | default: '#' }}" class="btn btn--white">
                {{- block.settings.button_label | escape -}}
              </a>
            {% endif %}
          </div>
        </section>

      {%- when 'bottom_cta' -%}
        <section class="bottom-cta-section" {{ block.shopify_attributes }}>
          <div class="container">
            {% if block.settings.eyebrow != blank %}
              <span class="eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {% endif %}

            <h2 class="heading-1">{{ block.settings.heading | escape }}</h2>

            <div class="body-regular">{{ block.settings.text }}</div>

            {% if block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link | default: '#' }}" class="btn">
                {{- block.settings.button_label | escape -}}
              </a>
            {% endif %}

            <div class="benefits-row">
              {% if block.settings.benefit_1 != blank -%}
                <span>{{ block.settings.benefit_1 | escape }}</span>
              {%- endif %}
              {% if block.settings.benefit_2 != blank -%}
                <span>{{ block.settings.benefit_2 | escape }}</span>
              {%- endif %}
              {% if block.settings.benefit_3 != blank -%}
                <span>{{ block.settings.benefit_3 | escape }}</span>
              {%- endif %}
            </div>
          </div>
        </section>
    {%- endcase -%}
  {% endfor %}
</div>

{% schema %}
{
  "name": "10 Reasons Presentation",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "color_black",
      "label": "Primary/Black",
      "default": "#000000"
    },
    {
      "type": "color",
