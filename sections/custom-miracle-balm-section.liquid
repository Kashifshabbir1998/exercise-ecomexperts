  "presets": [
    {
      "name": "10 Reasons Presentation",
      "blocks": [
        { "type": "hero" },
        {
          "type": "feature",
          "settings": {
            "number": "01",
            "heading": "One product replaces five",
            "text": "<p>Miracle Balm does the work of your entire makeup bag in a single compact. Less clutter on your vanity, fewer decisions before your 7 AM call. <strong>One tin. Five functions. Done.</strong></p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "number": "02",
            "heading": "30-second application",
