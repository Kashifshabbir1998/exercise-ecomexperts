{%- comment -%}
  Variant Pills Snippet — Color variant selector pills for bundle product cards
  Required variables:
    - bprod    {Object} — The Shopify product object
    - block    {Object} — The Shopify block object (provides block.id)
    - bvariant {Object} — The selected/first available variant (used to detect current selection)
{%- endcomment -%}

{%- comment -%} Find the color option index {%- endcomment -%}
{%- assign color_idx = nil -%}
{%- for opt in bprod.options_with_values -%}
  {%- assign opt_lc = opt.name | downcase -%}
  {%- if opt_lc == 'color' or opt_lc == 'colour' -%}
    {%- assign color_idx = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

{%- if color_idx != nil -%}
  <div
    class="sd-bundle-builder__variant-pills"
    role="group"
    aria-label="Color options for {{ bprod.title | escape }}"
    data-variant-pills="{{ block.id }}"
  >
    {%- assign seen_colors = '' -%}
    {%- for vnt in bprod.variants -%}
      {%- assign vnt_color = vnt.options[color_idx] -%}
      {%- unless seen_colors contains vnt_color -%}
        {%- assign seen_colors = seen_colors | append: vnt_color | append: '|' -%}
        {%- assign pill_alt = vnt.title | escape -%}
        {%- assign is_first_pill = false -%}
        {%- if forloop.first -%}
          {%- assign is_first_pill = true -%}
        {%- endif -%}
        <button
          type="button"
          class="sd-bundle-builder__variant-pill{% if is_first_pill %} sd-bundle-builder__variant-pill--active{% endif %}"
          data-variant-id="{{ vnt.id }}"
          data-block-id="{{ block.id }}"
          data-color="{{ vnt_color | escape }}"
          data-price="{{ vnt.price }}"
          aria-label="{{ vnt_color }}"
          aria-pressed="{% if is_first_pill %}true{% else %}false{% endif %}"
        >
          {%- if vnt.image != blank -%}
            {{ vnt.image | image_url: width: 24 | image_tag:
              loading: 'lazy',
              widths: '24,48',
              alt: pill_alt,
              class: 'sd-bundle-builder__pill-img'
            }}
          {%- endif -%}
          <span class="sd-bundle-builder__pill-label">{{ vnt_color }}</span>
        </button>
      {%- endunless -%}
    {%- endfor -%}
  </div>
{%- endif -%}