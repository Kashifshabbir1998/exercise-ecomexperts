{%- comment -%}
  Snippet: sd-snip-hero-collage.liquid
  Description: Renders a 4-image collage grid for the hero section with optional decorative frame on image 2.

  Expected variables:
  - image_1        {image}   — Top-left image object
  - image_2        {image}   — Top-right image object (receives decorative frame)
  - image_3        {image}   — Bottom-left image object
  - image_4        {image}   — Bottom-right image object
  - image_1_alt    {string}  — Alt text for image 1
  - image_2_alt    {string}  — Alt text for image 2
  - image_3_alt    {string}  — Alt text for image 3
  - image_4_alt    {string}  — Alt text for image 4
  - show_frame     {boolean} — Whether to show the decorative frame overlay on image 2
{%- endcomment -%}

<div class="sd-snip-hero-collage">

  <!-- Image 1: Top Left -->
  <div class="sd-snip-hero-collage__cell sd-snip-hero-collage__cell--1">
    {% unless image_1 == blank %}
      {%- assign alt_1 = image_1_alt | default: '' | escape -%}
      {{ image_1 | image_url: width: 600 | image_tag:
          loading: 'eager',
          widths: '300,400,500,600',
          sizes: '(max-width: 749px) 45vw, 300px',
          alt: alt_1,
          class: 'sd-snip-hero-collage__img'
      }}
    {% else %}
      <div class="sd-snip-hero-collage__img-placeholder sd-snip-hero-collage__img-placeholder--1" aria-hidden="true">
        <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
          <rect width="400" height="500" fill="#E8DDD0"/>
          <rect x="140" y="180" width="120" height="140" rx="60" fill="#C4A882" opacity="0.5"/>
        </svg>
      </div>
    {% endunless %}
  </div>

  <!-- Image 2: Top Right (with optional decorative frame) -->
  <div class="sd-snip-hero-collage__cell sd-snip-hero-collage__cell--2">
    {% unless image_2 == blank %}
      {%- assign alt_2 = image_2_alt | default: '' | escape -%}
      {{ image_2 | image_url: width: 600 | image_tag:
          loading: 'eager',
          widths: '300,400,500,600',
          sizes: '(max-width: 749px) 45vw, 300px',
          alt: alt_2,
          class: 'sd-snip-hero-collage__img'
      }}
    {% else %}
      <div class="sd-snip-hero-collage__img-placeholder sd-snip-hero-collage__img-placeholder--2" aria-hidden="true">
        <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
          <rect width="400" height="500" fill="#D4C5B0"/>
          <rect x="140" y="180" width="120" height="140" rx="60" fill="#B8956A" opacity="0.5"/>
        </svg>
      </div>
    {% endunless %}

    {% if show_frame %}
      <div class="sd-snip-hero-collage__frame" aria-hidden="true"></div>
    {% endif %}
  </div>

  <!-- Image 3: Bottom Left -->
  <div class="sd-snip-hero-collage__cell sd-snip-hero-collage__cell--3">
    {% unless image_3 == blank %}
      {%- assign alt_3 = image_3_alt | default: '' | escape -%}
      {{ image_3 | image_url: width: 600 | image_tag:
          loading: 'lazy',
          widths: '300,400,500,600',
          sizes: '(max-width: 749px) 45vw, 300px',
          alt: alt_3,
          class: 'sd-snip-hero-collage__img'
      }}
    {% else %}
      <div class="sd-snip-hero-collage__img-placeholder sd-snip-hero-collage__img-placeholder--3" aria-hidden="true">
        <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
          <rect width="400" height="500" fill="#EAE0D4"/>
          <rect x="140" y="180" width="120" height="140" rx="60" fill="#C9A882" opacity="0.5"/>
        </svg>
      </div>
    {% endunless %}
  </div>

  <!-- Image 4: Bottom Right -->
  <div class="sd-snip-hero-collage__cell sd-snip-hero-collage__cell--4">
    {% unless image_4 == blank %}
      {%- assign alt_4 = image_4_alt | default: '' | escape -%}
      {{ image_4 | image_url: width: 600 | image_tag:
          loading: 'lazy',
          widths: '300,400,500,600',
          sizes: '(max-width: 749px) 45vw, 300px',
          alt: alt_4,
          class: 'sd-snip-hero-collage__img'
      }}
    {% else %}
      <div class="sd-snip-hero-collage__img-placeholder sd-snip-hero-collage__img-placeholder--4" aria-hidden="true">
        <svg viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
          <rect width="400" height="500" fill="#DDD0C2"/>
          <rect x="140" y="180" width="120" height="140" rx="60" fill="#B8906A" opacity="0.5"/>
        </svg>
      </div>
    {% endunless %}
  </div>

</div>