{%- comment -%}
  Snippet: product-media-gallery
  Renders the vertical thumbnail strip and main product image for the PDP.

  Variables accepted:
  - product: {Object} Shopify product object (required)
  - section: {Object} Shopify section object (required)
{%- endcomment -%}

<!-- Vertical Thumbnail Strip -->
<div class="sd-qw111__thumbnails" id="thumbnails-{{ section.id }}">
  <div class="sd-qw111__thumb-track swiper" id="thumb-swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      {%- for image in product.images -%}
        <div class="swiper-slide sd-qw111__thumb-slide">
          <button
            type="button"
            class="sd-qw111__thumb-btn{% if forloop.first %} is-active{% endif %}"
            data-image-id="{{ image.id }}"
            data-image-index="{{ forloop.index0 }}"
            aria-label="{{ 'sections.sd_qw111.thumbnail_label' | t: index: forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {{
              image
              | image_url: width: 300
              | image_tag:
                loading: 'lazy',
                widths: '150,300',
                width: 150,
                height: 150,
                alt: image.alt | default: product.title
            }}
          </button>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- Thumbnail down-arrow pagination -->
  <button
    type="button"
    class="sd-qw111__thumb-next"
    aria-label="{{ 'sections.sd_qw111.next_image' | t }}"
  >
    <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true" focusable="false">
      <path d="M1 1L8 8L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<!-- Main Image Display -->
<div class="sd-qw111__main-image" id="main-image-{{ section.id }}">
  {%- assign featured = product.selected_or_first_available_variant.image | default: product.featured_image -%}
  {%- if featured != blank -%}
    {{
      featured
      | image_url: width: 1200
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '600,800,1000,1200',
        sizes: '(min-width: 750px) 55vw, 100vw',
        width: 800,
        height: 960,
        alt: featured.alt | default: product.title,
        class: 'sd-qw111__main-img',
        id: 'main-product-image-' | append: section.id,
        data-current-image-id: featured.id
    }}
  {%- else -%}
    <div class="sd-qw111__main-img-placeholder">
      {{ 'product-1' | placeholder_svg_tag: 'sd-qw111__placeholder-svg' }}
    </div>
  {%- endif -%}
</div>