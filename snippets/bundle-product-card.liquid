{%- comment -%}
  Bundle Product Card Snippet
  Required variables:
    - block        {Object}  — The Shopify block object (provides block.id, block.settings, block.shopify_attributes)
    - bprod        {Object}  — The Shopify product object
    - bvariant     {Object}  — The selected/first available variant
    - b_has_compare {Boolean} — Whether the variant has a compare-at price
    - b_save_pct   {Number}  — Calculated save percentage (0 if no compare price)
{%- endcomment -%}

{%- if bprod != blank -%}
  <div
    class="sd-bundle-builder__product-card"
    data-block-id="{{ block.id }}"
    data-product-id="{{ bprod.id }}"
    data-step="1"
    {{ block.shopify_attributes }}
  >

    <!-- Save badge -->
    {%- if b_has_compare and b_save_pct > 0 -%}
      <div class="sd-bundle-builder__save-badge">
        Save {{ b_save_pct }}%
      </div>
    {%- endif -%}

    <!-- Product image -->
    <div class="sd-bundle-builder__card-image-wrap">
      {%- if bprod.featured_image != blank -%}
        {%- assign card_img_alt = bprod.featured_image.alt | default: bprod.title | escape -%}
        {{ bprod.featured_image | image_url: width: 300 | image_tag:
          loading: 'lazy',
          widths: '150,300',
          alt: card_img_alt,
          class: 'sd-bundle-builder__card-image'
        }}
      {%- endif -%}
    </div>

    <!-- Card body -->
    <div class="sd-bundle-builder__card-body">
      <h3 class="sd-bundle-builder__card-title">{{ bprod.title }}</h3>

      {%- unless bprod.description == blank -%}
        <p class="sd-bundle-builder__card-desc">
          {{ bprod.description | strip_html | truncate: 80 }}
          {%- if block.settings.learn_more_url != blank -%}
            <a
              href="{{ block.settings.learn_more_url }}"
              class="sd-bundle-builder__learn-more"
              aria-label="Learn more about {{ bprod.title | escape }}"
            >Learn More</a>
          {%- else -%}
            <a
              href="{{ bprod.url }}"
              class="sd-bundle-builder__learn-more"
              aria-label="Learn more about {{ bprod.title | escape }}"
            >Learn More</a>
          {%- endif -%}
        </p>
      {%- endunless -%}

      <!-- Color variant pills -->
      {%- render 'variant-pills', bprod: bprod, block: block, bvariant: bvariant -%}

      <!-- Quantity stepper + price row -->
      <div class="sd-bundle-builder__card-footer">
        {%- render 'quantity-stepper', block: block, bprod: bprod, bvariant: bvariant -%}

        <!-- Price display -->
        <div class="sd-bundle-builder__price" data-price-display="{{ block.id }}">
          {%- if b_has_compare -%}
            <span class="sd-bundle-builder__price-compare">
              {{ bvariant.compare_at_price | money }}
            </span>
          {%- endif -%}
          <span class="sd-bundle-builder__price-current">
            {{ bvariant.price | money }}
          </span>
        </div>
      </div>

    </div>
  </div>
{%- endif -%}