{%- comment -%}
  Bundle Step Accordion Snippet
  Required variables:
    - step_number       {Number}  — Step number (1, 2, 3, or 4)
    - step_total        {Number}  — Total number of steps (e.g. 4)
    - tracker_label     {String}  — Text shown in the tracker label (e.g. "STEP 1 OF 4")
    - step_heading      {String}  — Heading text for the step
    - step_icon         {Object}  — Optional image object for the step icon
    - step_open         {Boolean} — Whether the step starts open
    - toggle_aria_label {String}  — Accessible label for the toggle button
    - step_content      {String}  — Inner HTML/Liquid content rendered inside the step (passed via capture)
    - cta_label         {String}  — Label for the next/action button
    - cta_data_attr     {String}  — data attribute value for the CTA button (e.g. "data-next-step" or "data-add-to-cart")
    - is_final_step     {Boolean} — If true, renders Add to Cart button instead of Next button
    - section_id        {String}  — The parent section.id (used for unique IDs)
{%- endcomment -%}

{%- assign is_open = false -%}
{%- if step_open == true or step_open == 'true' -%}
  {%- assign is_open = true -%}
{%- endif -%}

<div
  class="sd-bundle-builder__step{% if is_open %} sd-bundle-builder__step--open{% endif %}"
  data-step="{{ step_number }}"
  data-step-open="{{ is_open }}"
>

  <!-- Step tracker label -->
  <div class="sd-bundle-builder__step-tracker{% unless is_open %} sd-bundle-builder__step-tracker--inactive{% endunless %}">
    {%- unless tracker_label == blank -%}
      {{ tracker_label }}
    {%- else -%}
      STEP {{ step_number }} OF {{ step_total | default: 4 }}
    {%- endunless -%}
  </div>

  <!-- Step header -->
  <div class="sd-bundle-builder__step-header{% if is_open %} sd-bundle-builder__step-header--open{% endif %}">
    <div class="sd-bundle-builder__step-title-group">

      <!-- Step icon -->
      <div class="sd-bundle-builder__step-icon" aria-hidden="true">
        {%- if step_icon != blank -%}
          {{ step_icon | image_url: width: 40 | image_tag: loading: 'lazy', widths: '40,80', alt: '' }}
        {%- else -%}
          {%- comment -%} Default fallback icon — generic shield/star {%- endcomment -%}
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="14" cy="14" r="11" stroke="#1a1a2e" stroke-width="1.5"/>
            <text x="14" y="19" text-anchor="middle" font-size="12" fill="#1a1a2e" font-family="sans-serif">{{ step_number }}</text>
          </svg>
        {%- endif -%}
      </div>

      <!-- Step heading -->
      <h2 class="sd-bundle-builder__step-heading">
        {%- unless step_heading == blank -%}
          {{ step_heading }}
        {%- else -%}
          Step {{ step_number }}
        {%- endunless -%}
      </h2>
    </div>

    <!-- Toggle button — open step shows selected count badge, closed steps show arrow -->
    {%- if is_open -%}
      <button
        type="button"
        class="sd-bundle-builder__selected-count"
        data-step-toggle="{{ step_number }}"
        aria-expanded="true"
        aria-label="{{ toggle_aria_label | default: 'Toggle step' }}"
      >
        <span data-selected-count="{{ step_number }}">0 selected</span>
        <span class="sd-bundle-builder__toggle-arrow sd-bundle-builder__toggle-arrow--up" aria-hidden="true">&#9650;</span>
      </button>
    {%- else -%}
      <button
        type="button"
        class="sd-bundle-builder__toggle-btn"
        data-step-toggle="{{ step_number }}"
        aria-expanded="false"
        aria-label="{{ toggle_aria_label | default: 'Toggle step' }}"
      >
        <span class="sd-bundle-builder__toggle-arrow" aria-hidden="true">&#9660;</span>
      </button>
    {%- endif -%}
  </div>

  <!-- Step content -->
  <div
    class="sd-bundle-builder__step-content{% unless is_open %} sd-bundle-builder__step-content--hidden{% endunless %}"
    data-step-content="{{ step_number }}"
  >
    {{ step_content }}

    <!-- Step CTA -->
    <div class="sd-bundle-builder__step-actions">
      {%- if is_final_step == true or is_final_step == 'true' -%}
        <button
          type="button"
          class="sd-bundle-builder__add-to-cart-btn"
          data-add-to-cart
          aria-label="{{ cta_label | default: 'Add Bundle to Cart' }}"
        >
          {{ cta_label | default: 'Add Bundle to Cart' }}
        </button>
      {%- else -%}
        <button
          type="button"
          class="sd-bundle-builder__next-btn"
          data-next-step="{{ step_number }}"
          aria-label="{{ cta_label | default: 'Next step' }}"
        >
          {{ cta_label | default: 'Next step' }}
        </button>
      {%- endif -%}
    </div>
  </div>

</div>