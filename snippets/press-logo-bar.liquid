{%- comment -%}
  Press Logo Bar Snippet
  Renders a single press logo block (image or text-based typography logo).

  Expected variables:
    - block        {Object} - The section block object (required)
    - publication_name {String} - The name of the publication (from block.settings.publication_name)
    - logo_image   {Object} - An image object for the logo (from block.settings.logo_image, optional)
    - logo_link    {String} - A URL to wrap the logo in a link (from block.settings.logo_link, optional)
    - style        {String} - Typography style class modifier (from block.settings.style)
{%- endcomment -%}

{%- liquid
  assign publication_name = block.settings.publication_name
  assign logo_image       = block.settings.logo_image
  assign logo_link        = block.settings.logo_link
  assign logo_style       = block.settings.style
-%}

<div class="swiper-slide sd-section__logo-slide" {{ block.shopify_attributes }}>

  {%- unless logo_link == blank -%}
    <a
      href="{{ logo_link }}"
      class="sd-section__logo-link"
      aria-label="{{ publication_name | escape }}"
      target="_blank"
      rel="noopener noreferrer"
    >
  {%- endunless -%}

  {%- if logo_image != blank -%}
    <div class="sd-section__logo-image-wrap">
      {{-
        logo_image
        | image_url: width: 300
        | image_tag:
          loading: 'lazy',
          widths: '150,300',
          alt: publication_name,
          class: 'sd-section__logo-img',
          width: 150,
          height: 60
      -}}
    </div>
  {%- else -%}
    {%- unless publication_name == blank -%}
      <!-- Text-based logo mimicking publication brand typography -->
      <span
        class="sd-section__logo-text sd-section__logo-text--{{ logo_style }}"
        aria-label="{{ publication_name | escape }}"
      >
        {{- publication_name -}}
      </span>
    {%- endunless -%}
  {%- endif -%}

  {%- unless logo_link == blank -%}
    </a>
  {%- endunless -%}

</div>